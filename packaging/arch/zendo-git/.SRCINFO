pkgbase = zendo-git
	pkgdesc = Every game in one library: Steam, Epic, GOG, Amazon and your own, with Proton and mods
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/leandrop-dev/zendo
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = git
	depends = gcc-libs
	depends = glib2
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libsoup3
	depends = libxkbcommon
	depends = systemd-libs
	depends = vulkan-icd-loader
	depends = wayland
	depends = webkit2gtk-4.1
	optdepends = steam: Steam games
	optdepends = heroic-games-launcher-bin: its installed games, and the legendary, gogdl and nile it bundles for Epic, GOG and Amazon
	optdepends = legendary: Epic games without Heroic
	optdepends = umu-launcher: Windows games through Proton
	optdepends = gamescope: a compositor of its own per game
	optdepends = mangohud: an overlay with the frame rate
	optdepends = gamemode: full performance while a game runs
	optdepends = 7zip: mods in 7z and rar archives
	optdepends = libarchive: mods in archives when 7-Zip is missing
	optdepends = xdg-utils: opening folders and links, and Nexus Mods links in Zendo
	provides = zendo
	conflicts = zendo
	options = !lto
	source = zendo::git+https://github.com/leandrop-dev/zendo.git
	sha256sums = SKIP

pkgname = zendo-git
