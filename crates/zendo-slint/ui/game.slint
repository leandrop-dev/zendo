// A game's page: its wide art faint behind the header, the cover, the title
// and badges, one bar of actions, the status chips, four tiles, then the
// sessions and the details. The Rust side (src/game_ui.rs) fills `GameData`;
// nothing here holds a game.

import { Colors, Space, Tr } from "style.slint";
import { ChipButton, ActionButton, TextField } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { ChipData } from "library.slint";

export struct Tile {
    label: string,
    value: string,
}

// A label and its value in the details card; `path` says the value is a
// folder or file that can be opened.
export struct Fact {
    label: string,
    value: string,
    path: bool,
    mono: bool,
    // The value opens this link, when there is one.
    url: string,
}

// A badge on the header that opens a page: ProtonDB's rating, say.
export struct Pill {
    label: string,
    tint: color,
    // 0 takes `tint`; 1, 2 and 3 take the theme's good, bad and dim.
    tone: int,
    // What it says on hover.
    tip: string,
    url: string,
}

// A screenshot: its small picture, and the address of the full one.
export struct Shot {
    thumb: image,
    ready: bool,
    full: string,
}

// A line of the system requirements.
export struct Req {
    label: string,
    minimum: string,
    recommended: string,
}

export struct Ach {
    icon: image,
    has-icon: bool,
    name: string,
    description: string,
    // When it was unlocked or how rare it is.
    side: string,
    unlocked: bool,
}

export global GameData {
    // Whether a game's page replaces the Library's grid.
    in-out property <bool> open;
    in property <string> title;
    in property <string> source-line;
    in property <image> cover;
    in property <bool> has-cover;
    in property <image> backdrop;
    in property <bool> has-backdrop;
    in property <string> favorite-badge;
    in property <string> hidden-badge;
    in property <bool> pinned;
    in property <bool> hidden;
    in property <bool> steam;
    // A game added by hand: Edit and Remove, and Remove pressed once.
    in property <bool> local;
    in property <bool> confirm-remove;
    // 0 Play, 1 Starting, 2 Running, 3 Stopping.
    in property <int> run-state;
    in property <string> line;
    in property <[ChipData]> statuses;
    in property <[Tile]> tiles;
    in property <[Fact]> sessions;
    in property <[Fact]> recent;
    in property <[Fact]> details;
    in property <[Fact]> technical;
    in property <bool> technical-open;
    in property <[Pill]> pills;
    // What the store says the game is about, empty when nothing does.
    in property <string> about;
    // No Steam game was found for it: the card that offers the way to give one.
    in property <string> no-match;
    in property <[Shot]> shots;
    in property <string> dlc-count;
    in property <[Fact]> dlc;
    in property <string> ach-summary;
    // The share unlocked, 0 to 1, or -1 when the store did not say.
    in property <float> ach-share: -1;
    in property <[Ach]> ach;
    // "Show 12 more", or empty.
    in property <string> ach-more;
    in property <string> req-source;
    in property <bool> req-both;
    in property <[Req]> req;
    // Cards that could not be asked: the card's name and why.
    in property <[Fact]> failures;
    // The Technical card's Steam app id row.
    in property <bool> steam-app-row;
    in property <string> steam-app-line;
    in-out property <string> steam-app-input;
    // Asked for by Rust (one more each time): scroll the page to its end.
    in-out property <int> scroll-end;
    in property <bool> steam-app-clearable;

    callback back();
    callback play();
    callback stop();
    callback toggle-pinned();
    callback toggle-hidden();
    callback manage-steam();
    callback wiki();
    callback status(int);
    callback open-path(string);
    callback toggle-technical();
    callback edit();
    callback remove();
    callback show-steam-app();
    callback more-achievements();
    callback retry();
    callback steam-app-save(string);
    callback steam-app-clear();
}

component Card inherits Rectangle {
    in property <string> heading;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        Text {
            text: root.heading.to-uppercase();
            font-size: 14px;
            font-weight: 700;
            color: Colors.foreground;
        }
        @children
    }
}

component FactRow inherits HorizontalLayout {
    in property <Fact> fact;
    spacing: Space.s;
    Text {
        width: 130px;
        text: root.fact.label;
        wrap: word-wrap;
        color: Colors.dim;
        vertical-alignment: top;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Space.s;
        if root.fact.url == "": Text {
            text: root.fact.value;
            font-size: root.fact.mono ? 12px : 14px;
            color: Colors.foreground;
            wrap: word-wrap;
        }
        if root.fact.url != "": Rectangle {
            height: link-text.preferred-height;
            link-text := Text {
                width: parent.width;
                text: root.fact.value;
                font-size: 14px;
                color: link-touch.has-hover ? Colors.accent : Colors.foreground;
            }
            link-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { GameData.open-path(root.fact.url); }
            }
        }
        if root.fact.path: ActionButton {
            label: Tr.t("files-open-folder");
            small: true;
            horizontal-stretch: 0;
            clicked => { GameData.open-path(root.fact.value); }
        }
    }
}

// A badge that opens a page, with its words on hover, below it.
component PillButton inherits Rectangle {
    in property <Pill> pill;
    property <color> tone: root.pill.tone == 1 ? Colors.good : root.pill.tone == 2 ? Colors.bad : root.pill.tone == 3 ? Colors.dim : root.pill.tint;
    width: pill-text.preferred-width + 14px;
    height: pill-text.preferred-height + 4px;
    background: touch.has-hover ? root.tone.with-alpha(0.25) : Colors.background.with-alpha(0.82);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.5);
    accessible-role: button;
    accessible-label: root.pill.label;
    accessible-action-default => { GameData.open-path(root.pill.url); }
    pill-text := Text {
        x: 7px;
        y: 2px;
        text: root.pill.label;
        font-size: 11px;
        font-weight: 700;
        color: root.tone;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { GameData.open-path(root.pill.url); }
    }
    if touch.has-hover && root.pill.tip != "": Rectangle {
        y: root.height + Space.xs;
        width: tip-text.preferred-width + 2 * Space.s;
        height: tip-text.preferred-height + 2 * Space.xs;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.line;
        tip-text := Text {
            x: Space.s;
            y: Space.xs;
            text: root.pill.tip;
            font-size: 12px;
            color: Colors.foreground;
        }
    }
}

export component GamePage inherits Rectangle {
    // The room for the page's content: its width less the margins and the
    // scroll bar.
    property <length> inner: root.width - 2 * Space.xl - 12px;
    // Whether the page's wide column has anything to say.
    property <bool> has-main: GameData.about != "" || GameData.no-match != "" || GameData.shots.length > 0
        || GameData.dlc.length > 0 || GameData.sessions.length > 0 || GameData.ach.length > 0
        || GameData.req.length > 0 || GameData.failures.length > 0;
    property <int> scroll-request: GameData.scroll-end;
    changed scroll-request => {
        sv.content-y = min(0px, -(sv.content-height - sv.visible-height));
    }
    sv := ScrollView {
        VerticalLayout {
            page := VerticalLayout {
                padding: Space.xl;
                spacing: Space.xl;
                // The back link, then the header over the faint wide art.
                HorizontalLayout {
                    alignment: start;
                    back := Rectangle {
                        width: back-text.preferred-width;
                        height: back-text.preferred-height;
                        back-text := Text {
                            text: Tr.t("game-back").to-uppercase();
                            font-size: 13px;
                            color: back-touch.has-hover ? Colors.accent : Colors.dim;
                        }
                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { GameData.back(); }
                        }
                    }
                }
                header := Rectangle {
                    // Above what follows, so a pill's words draw over it.
                    z: 1;
                    height: 360px;
                    clip: true;
                    if GameData.has-backdrop: Image {
                        width: 100%;
                        height: 100%;
                        source: GameData.backdrop;
                        image-fit: cover;
                        opacity: 0.22;
                    }
                    HorizontalLayout {
                        padding: Space.l;
                        spacing: Space.xl;
                        Rectangle {
                            width: 200px;
                            height: 300px;
                            clip: true;
                            background: Colors.surface;
                            if GameData.has-cover: Image {
                                width: 100%;
                                height: 100%;
                                source: GameData.cover;
                                image-fit: cover;
                            }
                            if !GameData.has-cover: Text {
                                x: Space.m;
                                width: parent.width - 2 * Space.m;
                                height: parent.height;
                                text: GameData.title;
                                font-size: 20px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: Colors.foreground;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: Space.s;
                            Text {
                                text: GameData.title;
                                font-size: 34px;
                                font-weight: 700;
                                color: Colors.foreground;
                                wrap: word-wrap;
                            }
                            Text {
                                text: GameData.source-line.to-uppercase();
                                font-size: 13px;
                                color: Colors.dim;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: Space.s;
                                padding-top: Space.s;
                                if GameData.pinned: ActionButton {
                                    label: GameData.favorite-badge;
                                    small: true;
                                    tint: Colors.accent;
                                }
                                if GameData.hidden: ActionButton {
                                    label: GameData.hidden-badge;
                                    small: true;
                                }
                                ActionButton {
                                    label: "PCGamingWiki";
                                    small: true;
                                    clicked => { GameData.wiki(); }
                                }
                                for pill in GameData.pills: PillButton { pill: pill; }
                            }
                        }
                    }
                }
                // Play, or Running with Stop; then the less pressed ones.
                VerticalLayout {
                    spacing: Space.s;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Space.m;
                        ActionButton {
                            label: GameData.run-state == 0 ? Tr.t("run-play")
                                : GameData.run-state == 1 ? Tr.t("run-state-starting")
                                : Tr.t("run-state-running");
                            primary: true;
                            enabled: GameData.run-state == 0;
                            clicked => { GameData.play(); }
                        }
                        if GameData.run-state >= 2: ActionButton {
                            label: GameData.run-state == 3 ? Tr.t("run-force-stop") : Tr.t("run-stop");
                            danger: true;
                            clicked => { GameData.stop(); }
                        }
                        ActionButton {
                            label: GameData.pinned ? Tr.t("game-unfavorite") : Tr.t("game-favorite");
                            clicked => { GameData.toggle-pinned(); }
                        }
                        ActionButton {
                            label: GameData.hidden ? Tr.t("game-unhide") : Tr.t("game-hide");
                            clicked => { GameData.toggle-hidden(); }
                        }
                        if GameData.local: ActionButton {
                            label: Tr.t("edit");
                            clicked => { GameData.edit(); }
                        }
                        if GameData.local: ActionButton {
                            label: GameData.confirm-remove ? Tr.t("really-remove") : Tr.t("remove");
                            danger: GameData.confirm-remove;
                            clicked => { GameData.remove(); }
                        }
                        if GameData.steam: ActionButton {
                            label: Tr.t("game-manage-steam");
                            clicked => { GameData.manage-steam(); }
                        }
                    }
                    Text {
                        text: GameData.line;
                        font-size: 14px;
                        color: Colors.dim;
                    }
                }
                // The play status: the chosen one is pressed again to clear it.
                HorizontalLayout {
                    alignment: start;
                    spacing: Space.s;
                    Text {
                        text: Tr.t("game-status").to-uppercase();
                        font-size: 12px;
                        color: Colors.dim;
                        vertical-alignment: center;
                    }
                    for chip in GameData.statuses: ChipButton {
                        label: chip.label;
                        chosen: chip.chosen;
                        clicked => { GameData.status(chip.id); }
                    }
                }
                HorizontalLayout {
                    spacing: Space.m;
                    for tile in GameData.tiles: Rectangle {
                        horizontal-stretch: 1;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.line;
                        VerticalLayout {
                            padding: Space.l;
                            spacing: Space.s;
                            Text {
                                text: tile.label.to-uppercase();
                                font-size: 12px;
                                color: Colors.dim;
                            }
                            Text {
                                text: tile.value;
                                font-size: 22px;
                                font-weight: 700;
                                color: Colors.foreground;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Space.xl;
                    if root.has-main: VerticalLayout {
                        width: (root.inner - Space.xl) * 0.6;
                        alignment: start;
                        spacing: Space.xl;
                        if GameData.about != "": Card {
                            heading: Tr.t("game-about");
                            Text {
                                text: GameData.about;
                                font-size: 14px;
                                color: Colors.foreground;
                                wrap: word-wrap;
                            }
                        }
                        if GameData.no-match != "": Card {
                            heading: Tr.t("game-about");
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: GameData.no-match;
                                    font-size: 13px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Tr.t("steam-app-set");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.show-steam-app(); }
                                }
                            }
                        }
                        if GameData.shots.length > 0: Card {
                            heading: Tr.t("screenshots-title");
                            Flickable {
                                height: 150px;
                                content-width: shots-row.preferred-width;
                                shots-row := HorizontalLayout {
                                    spacing: Space.m;
                                    for shot in GameData.shots: Rectangle {
                                        width: shot.ready ? self.height * shot.thumb.width / max(1, shot.thumb.height) : 267px;
                                        height: 150px;
                                        background: Colors.raised;
                                        if shot.ready: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: shot.thumb;
                                            image-fit: cover;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { GameData.open-path(shot.full); }
                                        }
                                    }
                                }
                            }
                        }
                        if GameData.dlc.length > 0: Card {
                            heading: Tr.t("dlc-title");
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: GameData.dlc-count;
                                    font-size: 13px;
                                    color: Colors.dim;
                                }
                                for line in GameData.dlc: HorizontalLayout {
                                    spacing: Space.m;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: line.label;
                                        font-size: 14px;
                                        color: Colors.foreground;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: line.value;
                                        font-size: 13px;
                                        color: Colors.good;
                                    }
                                }
                            }
                        }
                        if GameData.sessions.length > 0: Card {
                            heading: Tr.t("stats-game-title");
                            VerticalLayout {
                                spacing: Space.l;
                                HorizontalLayout {
                                    spacing: Space.xl;
                                    for fact in GameData.sessions: VerticalLayout {
                                        spacing: Space.xs;
                                        Text {
                                            text: fact.label.to-uppercase();
                                            font-size: 12px;
                                            color: Colors.dim;
                                        }
                                        Text {
                                            text: fact.value;
                                            font-size: 18px;
                                            font-weight: 700;
                                            color: Colors.foreground;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: Space.xs;
                                    for fact in GameData.recent: HorizontalLayout {
                                        spacing: Space.l;
                                        Text {
                                            width: 110px;
                                            text: fact.label;
                                            font-size: 13px;
                                            color: Colors.dim;
                                        }
                                        Text {
                                            text: fact.value;
                                            font-size: 13px;
                                            color: Colors.foreground;
                                        }
                                    }
                                }
                            }
                        }
                        if GameData.ach.length > 0: Card {
                            heading: Tr.t("achievements-title");
                            VerticalLayout {
                                spacing: Space.m;
                                HorizontalLayout {
                                    spacing: Space.m;
                                    Text {
                                        text: GameData.ach-summary;
                                        font-size: 14px;
                                        color: GameData.ach-share >= 0 ? Colors.foreground : Colors.dim;
                                        wrap: word-wrap;
                                        horizontal-stretch: GameData.ach-share >= 0 ? 0 : 1;
                                    }
                                    if GameData.ach-share >= 0: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 6px;
                                        y: 8px;
                                        background: Colors.raised;
                                        Rectangle {
                                            x: 0;
                                            width: parent.width * clamp(GameData.ach-share, 0, 1);
                                            background: Colors.accent;
                                        }
                                    }
                                }
                                for a in GameData.ach: HorizontalLayout {
                                    spacing: Space.m;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        background: Colors.raised;
                                        clip: true;
                                        if a.has-icon: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: a.icon;
                                            image-fit: cover;
                                        }
                                        if !a.has-icon: Text {
                                            text: "?";
                                            color: Colors.dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: Space.xs;
                                        Text {
                                            text: a.name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Colors.foreground;
                                            wrap: word-wrap;
                                        }
                                        if a.description != "": Text {
                                            text: a.description;
                                            font-size: 13px;
                                            color: Colors.dim;
                                            wrap: word-wrap;
                                        }
                                    }
                                    Text {
                                        text: a.side;
                                        font-size: 13px;
                                        color: a.unlocked ? Colors.good : Colors.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                if GameData.ach-more != "": ActionButton {
                                    label: GameData.ach-more;
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.more-achievements(); }
                                }
                            }
                        }
                        if GameData.req.length > 0: Card {
                            heading: Tr.t("requirements-title");
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: GameData.req-source;
                                    font-size: 13px;
                                    color: Colors.dim;
                                }
                                if GameData.req-both: HorizontalLayout {
                                    spacing: Space.s;
                                    Rectangle { width: 130px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: Tr.t("requirements-minimum");
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Colors.dim;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: Tr.t("requirements-recommended");
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Colors.dim;
                                    }
                                }
                                for r in GameData.req: HorizontalLayout {
                                    spacing: Space.s;
                                    Text {
                                        width: 130px;
                                        text: r.label;
                                        font-size: 14px;
                                        color: Colors.dim;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: r.minimum;
                                        font-size: 14px;
                                        color: Colors.foreground;
                                        wrap: word-wrap;
                                    }
                                    if GameData.req-both: Text {
                                        horizontal-stretch: 1;
                                        text: r.recommended;
                                        font-size: 14px;
                                        color: Colors.foreground;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        // Cards that could not be asked, with the way to ask again.
                        for failed in GameData.failures: Card {
                            heading: failed.label;
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: failed.value;
                                    font-size: 13px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Tr.t("try-again");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.retry(); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        width: root.has-main ? (root.inner - Space.xl) * 0.4 : root.inner;
                        alignment: start;
                        spacing: Space.xl;
                        Card {
                            heading: Tr.t("game-details");
                            VerticalLayout {
                                spacing: Space.m;
                                for fact in GameData.details: FactRow { fact: fact; }
                            }
                        }
                        Card {
                            heading: Tr.t("game-technical");
                            VerticalLayout {
                                spacing: Space.m;
                                ActionButton {
                                    label: GameData.technical-open ? "−" : "+";
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.toggle-technical(); }
                                }
                                if GameData.technical-open: VerticalLayout {
                                    spacing: Space.m;
                                    for fact in GameData.technical: FactRow { fact: fact; }
                                    if GameData.steam-app-row: HorizontalLayout {
                                        spacing: Space.s;
                                        Text {
                                            width: 130px;
                                            text: Tr.t("steam-app-label");
                                            wrap: word-wrap;
                                            color: Colors.dim;
                                            vertical-alignment: top;
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: Space.s;
                                            Text {
                                                text: GameData.steam-app-line;
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: Colors.foreground;
                                                wrap: word-wrap;
                                            }
                                            HorizontalLayout {
                                                spacing: Space.s;
                                                TextField {
                                                    horizontal-stretch: 1;
                                                    height: 28px;
                                                    text <=> GameData.steam-app-input;
                                                    placeholder: Tr.t("steam-app-placeholder");
                                                    accepted => { GameData.steam-app-save(GameData.steam-app-input); }
                                                }
                                                ActionButton {
                                                    label: Tr.t("steam-app-save");
                                                    small: true;
                                                    clicked => { GameData.steam-app-save(GameData.steam-app-input); }
                                                }
                                                if GameData.steam-app-clearable: ActionButton {
                                                    label: Tr.t("steam-app-clear");
                                                    small: true;
                                                    clicked => { GameData.steam-app-clear(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
