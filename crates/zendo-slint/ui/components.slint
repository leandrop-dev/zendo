// Zendo's own controls, in the look of the Iced window's `app/style.rs`: flat,
// square, the accent for the current one. Pages use these, not Slint's
// widgets, so the look is set once.

import { Colors, Space } from "style.slint";

// A tab in the top bar: the name in capitals, a count beside it when there is
// one, and the accent rim when it is the current page.
export component Tab inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <bool> current;
    callback clicked;

    background: touch.has-hover ? Colors.raised : transparent;
    border-width: 1px;
    border-color: root.current ? Colors.accent : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.m;
        padding-right: Space.m;
        padding-top: Space.s;
        padding-bottom: Space.s;
        spacing: Space.s;
        Text {
            text: root.label.to-uppercase();
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            color: root.current ? Colors.accent : touch.has-hover ? Colors.foreground : Colors.dim;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: 12px;
            vertical-alignment: center;
            color: Colors.dim;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A square button in the top bar that holds an icon, with a count beside it
// when there is one; its name shows below it on hover.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> count;
    in property <bool> current;
    callback clicked;

    height: 34px;
    min-width: 34px;
    background: touch.has-hover ? Colors.raised : transparent;
    border-width: 1px;
    border-color: root.current ? Colors.accent : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.s;
        padding-right: Space.s;
        spacing: Space.s;
        alignment: center;
        Image {
            source: root.icon;
            colorize: root.current ? Colors.accent : Colors.foreground;
            width: 18px;
            height: 18px;
            y: (root.height - self.height) / 2 - 1px;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: 12px;
            vertical-alignment: center;
            color: Colors.dim;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Shown on hover, below the button. Drawn outside the button's own
    // rectangle, so whatever holds the button must be above the page (`z`),
    // and it takes no clicks, which a `PopupWindow` here swallowed.
    if touch.has-hover: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height + Space.xs;
        width: tip-text.preferred-width + 2 * Space.s;
        height: tip-text.preferred-height + 2 * Space.xs;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.line;
        tip-text := Text {
            x: Space.s;
            y: Space.xs;
            text: root.label.to-uppercase();
            font-size: 12px;
            color: Colors.foreground;
        }
    }
}

// A toggle in a page's toolbar: the name in capitals, a count when there is
// one, and the accent rim while it is chosen.
export component ChipButton inherits Rectangle {
    in property <string> label;
    in property <string> count;
    in property <bool> chosen;
    callback clicked;

    background: touch.has-hover ? Colors.raised : transparent;
    border-width: 1px;
    border-color: root.chosen ? Colors.accent : Colors.line;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Space.m;
        padding-right: Space.m;
        padding-top: Space.xs;
        padding-bottom: Space.xs;
        spacing: 6px;
        Text {
            text: root.label.to-uppercase();
            font-size: 13px;
            vertical-alignment: center;
            color: root.chosen ? Colors.accent : Colors.foreground;
        }
        if root.count != "": Text {
            text: root.count;
            font-size: 12px;
            vertical-alignment: center;
            color: root.chosen ? Colors.accent : Colors.dim;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The search box: a rim that takes the accent while it has the keyboard, and
// the hint while it is empty.
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // The user changed the text.
    callback edited(string);
    // Enter was pressed in the field.
    callback accepted;
    forward-focus: input;
    public function paste() { input.paste(); }

    width: 220px;
    height: 34px;
    background: Colors.surface;
    border-width: 1px;
    border-color: input.has-focus ? Colors.accent : Colors.line;
    accessible-role: text-input;
    accessible-label: root.placeholder;

    input := TextInput {
        x: Space.m;
        width: root.width - 2 * Space.m;
        height: root.height;
        vertical-alignment: center;
        text <=> root.text;
        color: Colors.foreground;
        font-size: 14px;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    if root.text == "": Text {
        x: Space.m;
        height: root.height;
        text: root.placeholder;
        color: Colors.dim;
        font-size: 14px;
        vertical-alignment: center;
    }
}

// A button for a page's actions: the name in capitals. `primary` is the
// accent's fill (Play), `danger` the red one (Stop); `tint` colours a badge
// that is not pressed.
export component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> small;
    in property <bool> enabled: true;
    in property <color> tint: Colors.foreground;
    callback clicked;

    private property <color> fill: root.primary ? Colors.accent : root.danger ? Colors.bad : transparent;
    background: root.fill != transparent
        ? (touch.has-hover && root.enabled ? root.fill.brighter(0.15) : root.fill)
        : (touch.has-hover && root.enabled ? Colors.raised : Colors.surface);
    border-width: 1px;
    border-color: root.fill != transparent ? root.fill : Colors.line;
    opacity: root.enabled ? 1.0 : 0.7;
    width: row.preferred-width;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    row := HorizontalLayout {
        padding-left: root.small ? Space.s : root.primary ? 32px : Space.l;
        padding-right: root.small ? Space.s : root.primary ? 32px : Space.l;
        padding-top: root.small ? 2px : root.primary ? 10px : Space.s;
        padding-bottom: root.small ? 2px : root.primary ? 10px : Space.s;
        Text {
            text: root.label.to-uppercase();
            font-size: root.small ? 11px : root.primary ? 16px : 13px;
            font-weight: root.primary || root.danger || root.small ? 700 : 400;
            vertical-alignment: center;
            color: root.fill != transparent ? (Colors.light ? #ffffff : #101010) : root.tint;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A line of text in a sheet: a rim that takes the accent while it has the
// keyboard, and the hint while it is empty. It fills the width it is given.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // Shows dots in place of the letters, for a key.
    in property <bool> password;
    // The user changed the text.
    callback edited(string);
    // Enter was pressed in the field.
    callback accepted;
    forward-focus: input;
    public function focus-field() { input.focus(); }
    // Takes the keyboard with the cursor after the text.
    public function focus-end() {
        input.focus();
        input.set-selection-offsets(input.text.character-count, input.text.character-count);
    }
    // Takes the keyboard and pastes the clipboard.
    public function paste-text() {
        input.focus();
        input.paste();
    }

    height: 34px;
    background: Colors.surface;
    border-width: 1px;
    border-color: input.has-focus ? Colors.accent : Colors.line;
    accessible-role: text-input;
    accessible-label: root.placeholder;

    input := TextInput {
        x: Space.m;
        width: root.width - 2 * Space.m;
        height: root.height;
        vertical-alignment: center;
        text <=> root.text;
        color: Colors.foreground;
        font-size: 14px;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    if root.text == "": Text {
        x: Space.m;
        width: root.width - 2 * Space.m;
        height: root.height;
        text: root.placeholder;
        color: Colors.dim;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Section inherits Rectangle {
    in property <string> heading;
    in property <string> about;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        Text {
            text: root.heading.to-uppercase();
            font-size: 14px;
            font-weight: 700;
            color: Colors.foreground;
        }
        // An explicit width: a wrapped text's height is measured at it.
        Text {
            width: root.width - 2 * Space.l;
            text: root.about;
            font-size: 13px;
            color: Colors.dim;
            wrap: word-wrap;
        }
        @children
    }
}

// A switch with its words beside it.
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled(bool);
    height: 24px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(!root.on); }
    HorizontalLayout {
        spacing: Space.m;
        Rectangle {
            width: 40px;
            height: 22px;
            y: 1px;
            background: root.on ? Colors.accent : Colors.raised;
            border-width: 1px;
            border-color: root.on ? Colors.accent : Colors.line;
            Rectangle {
                width: 16px;
                height: 16px;
                y: 3px;
                x: root.on ? parent.width - self.width - 3px : 3px;
                background: root.on ? (Colors.light ? #ffffff : #101010) : Colors.dim;
            }
        }
        Text {
            text: root.label;
            font-size: 14px;
            color: Colors.foreground;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// A line of words in one of the page's colours: 1 good, 2 bad, 3 dim.
export component Note inherits Text {
    in property <int> tone;
    font-size: 13px;
    wrap: word-wrap;
    color: root.tone == 1 ? Colors.good : root.tone == 2 ? Colors.bad : Colors.dim;
}

// A button in a list's row. With no label it takes no room, so a row can
// hold every button it might have and show the ones it needs.
export component RowButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger;
    // The one to press first in a row (Resume, Try again).
    in property <bool> primary;
    callback clicked;
    // The gap to what is before it is inside the button, so a button with no
    // label takes no room at all.
    width: root.label == "" ? 0px : words.preferred-width + 2 * Space.m + Space.s;
    height: root.label == "" ? 0px : 28px;
    visible: root.label != "";
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Rectangle {
        x: Space.s;
        width: parent.width - Space.s;
        background: touch.has-hover && root.enabled
            ? (root.danger ? Colors.bad.brighter(0.15) : root.primary ? Colors.accent.brighter(0.15) : Colors.raised)
            : (root.danger ? Colors.bad : root.primary ? Colors.accent : Colors.surface);
        border-width: 1px;
        border-color: root.danger ? Colors.bad : root.primary ? Colors.accent : Colors.line;
        opacity: root.enabled ? 1.0 : 0.7;
        words := Text {
            x: Space.m;
            text: root.label.to-uppercase();
            font-size: 11px;
            font-weight: 700;
            height: parent.height;
            vertical-alignment: center;
            color: root.danger || root.primary ? (Colors.light ? #ffffff : #101010) : Colors.foreground;
        }
    }
    touch := TouchArea {
        x: Space.s;
        width: parent.width - Space.s;
        mouse-cursor: root.enabled ? pointer : default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}


// A box that is ticked or not, for a row in a list.
export component CheckBox inherits Rectangle {
    in property <bool> on;
    in property <string> label;
    callback toggled(bool);
    width: 20px;
    height: 20px;
    background: touch.has-hover ? Colors.raised : Colors.surface;
    border-width: 1px;
    border-color: root.on ? Colors.accent : Colors.line;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.on;
    accessible-action-default => { root.toggled(!root.on); }
    Rectangle {
        width: 10px;
        height: 10px;
        background: root.on ? Colors.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}
