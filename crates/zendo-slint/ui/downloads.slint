// The Downloads page: what the queue is doing, what waits, what is paused and
// what ended. Rust (src/downloads_ui.rs) fills `DownloadsData`; nothing here
// holds the queue.

import { Colors, Space, Tr } from "style.slint";
import { ActionButton, RowButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// A job in a list. Rust fills every text; an empty one is not drawn.
export struct JobRow {
    id: string,
    title: string,
    // "Install · Epic".
    line: string,
    // A dim line: "Waits until the game is closed".
    note: string,
    // Why it failed, in red.
    error: string,
    // How a finished job ended.
    verdict: string,
    verdict-bad: bool,
    // The first button (Pause, Resume, Try again) and Cancel; Open is for a
    // finished job. An empty label is no button.
    first: string,
    first-primary: bool,
    cancel: string,
    open: string,
}

// A line of the Steam card: an install, an uninstall or a verify asked of
// Steam, or what Steam is downloading. Rust fills every text.
export struct SteamRow {
    app: string,
    title: string,
    line: string,
    // How far, 0 to 100, or -1 for no bar.
    percent: float,
    // Stop waiting, for an install Steam has not started; empty is no button.
    forget: string,
}

export global DownloadsData {
    // Nothing queued and nothing finished: no tiles.
    in property <bool> empty;
    // Nothing at all going on either, Steam's installs included: the page
    // invites to the Store.
    in property <bool> invite;
    // Steam has something going: its card, with Open Steam's downloads.
    in property <bool> steam-show;
    in property <[SteamRow]> steam-rows;
    callback steam-forget(string);
    callback steam-open();
    // The counts, as tiles.
    in property <string> up-next-count;
    in property <string> paused-count;
    in property <string> finished-count;
    // Closing was asked for while a job runs.
    in property <bool> asking;
    // The running job's card.
    in property <bool> running;
    in property <string> current-title;
    in property <string> current-line;
    // How far it is, 0 to 100, or -1 when the engine did not say.
    in property <float> percent: -1;
    in property <string> progress-line;
    in property <string> pause-label;
    in property <string> cancel-label;
    in property <bool> pause-on;
    in property <bool> cancel-on;
    in property <[JobRow]> up-next;
    in property <[JobRow]> paused;
    in property <[JobRow]> finished;
    callback pause(string);
    callback resume(string);
    callback cancel(string);
    callback open(string);
    callback clear();
    callback go-store();
    callback close-anyway();
    callback stay-open();
    // The texts Rust builds read the language again.
    callback relabel();
}

component CountTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    height: 64px;
    VerticalLayout {
        padding: Space.m;
        spacing: 2px;
        Text {
            text: root.label.to-uppercase();
            font-size: 11px;
            color: Colors.dim;
        }
        Text {
            text: root.value;
            font-size: 22px;
            font-weight: 700;
            color: Colors.foreground;
        }
    }
}

component Heading inherits Text {
    font-size: 12px;
    font-weight: 700;
    color: Colors.dim;
}

// One job: its name, what it is and what became of it, with the buttons it
// has. `kind` 0 waits its turn, 1 is paused, 2 is finished.
component JobCard inherits Rectangle {
    in property <JobRow> job;
    in property <int> kind;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    height: row.preferred-height;

    row := HorizontalLayout {
        padding-left: Space.l;
        padding-right: Space.l;
        padding-top: Space.s;
        padding-bottom: Space.s;
        spacing: Space.m;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.job.title;
                font-size: 15px;
                color: Colors.foreground;
                overflow: elide;
            }
            Text {
                text: root.job.line;
                font-size: 12px;
                color: Colors.dim;
                overflow: elide;
            }
            Text {
                height: root.job.note == "" ? 0px : 16px;
                text: root.job.note;
                font-size: 12px;
                color: Colors.dim;
                overflow: elide;
            }
            Text {
                height: root.job.error == "" ? 0px : 16px;
                text: root.job.error;
                font-size: 12px;
                color: Colors.bad;
                overflow: elide;
            }
        }
        Text {
            width: root.job.verdict == "" ? 0px : root.width * 0.4;
            text: root.job.verdict;
            font-size: 13px;
            color: root.job.verdict-bad ? Colors.bad : Colors.good;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        RowButton {
            label: root.job.first;
            primary: root.job.first-primary;
            clicked => {
                if root.kind == 0 {
                    DownloadsData.pause(root.job.id);
                } else {
                    DownloadsData.resume(root.job.id);
                }
            }
        }
        RowButton {
            label: root.job.cancel;
            clicked => { DownloadsData.cancel(root.job.id); }
        }
        RowButton {
            label: root.job.open;
            clicked => { DownloadsData.open(root.job.id); }
        }
    }
}

// One line of the Steam card: the name and what Steam is doing, Stop waiting
// when it applies, and a bar for a download.
component SteamLine inherits VerticalLayout {
    in property <SteamRow> item;
    spacing: Space.s;
    HorizontalLayout {
        spacing: Space.m;
        Text {
            horizontal-stretch: 1;
            text: root.item.title;
            font-size: 15px;
            color: Colors.foreground;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: root.item.line;
            font-size: 13px;
            color: Colors.dim;
            vertical-alignment: center;
        }
        RowButton {
            label: root.item.forget;
            clicked => { DownloadsData.steam-forget(root.item.app); }
        }
    }
    Rectangle {
        height: root.item.percent >= 0 ? 8px : 0px;
        background: Colors.raised;
        Rectangle {
            x: 0px;
            width: parent.width * Math.min(root.item.percent, 100) / 100;
            background: Colors.accent;
        }
    }
}

export component DownloadsPage inherits Rectangle {
    ScrollView {
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            // A right margin keeps the scrollbar off the cards.
            width: parent.width - 14px;
            x: 0px;
            padding: Space.xl;
            spacing: Space.l;
            alignment: start;

            if !DownloadsData.empty: HorizontalLayout {
                spacing: Space.m;
                CountTile {
                    label: Tr.t("downloads-up-next");
                    value: DownloadsData.up-next-count;
                }
                CountTile {
                    label: Tr.t("downloads-paused");
                    value: DownloadsData.paused-count;
                }
                CountTile {
                    label: Tr.t("downloads-finished");
                    value: DownloadsData.finished-count;
                }
            }

            // Closing while a job runs asks first.
            if DownloadsData.asking: Rectangle {
                background: Colors.surface;
                border-width: 1px;
                border-color: Colors.accent;
                height: ask.preferred-height;
                ask := VerticalLayout {
                    padding: Space.l;
                    spacing: Space.s;
                    Text {
                        text: Tr.t("downloads-running-title");
                        font-size: 15px;
                        font-weight: 700;
                        color: Colors.foreground;
                    }
                    Text {
                        text: Tr.t("downloads-running-about");
                        font-size: 13px;
                        color: Colors.dim;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Space.m;
                        alignment: start;
                        ActionButton {
                            label: Tr.t("downloads-close-anyway");
                            primary: true;
                            clicked => { DownloadsData.close-anyway(); }
                        }
                        ActionButton {
                            label: Tr.t("downloads-keep");
                            clicked => { DownloadsData.stay-open(); }
                        }
                    }
                }
            }

            // What Steam is doing for Zendo; Steam shows its own progress too.
            if DownloadsData.steam-show: Rectangle {
                background: Colors.surface;
                border-width: 1px;
                border-color: Colors.line;
                height: steam-card.preferred-height;
                steam-card := VerticalLayout {
                    padding: Space.l;
                    spacing: Space.m;
                    HorizontalLayout {
                        spacing: Space.m;
                        Text {
                            horizontal-stretch: 1;
                            text: Tr.t("steam-downloads-title").to-uppercase();
                            font-size: 14px;
                            font-weight: 700;
                            color: Colors.foreground;
                            vertical-alignment: center;
                        }
                        ActionButton {
                            label: Tr.t("steam-open-downloads");
                            small: true;
                            clicked => { DownloadsData.steam-open(); }
                        }
                    }
                    Text {
                        width: parent.width - 2 * Space.l;
                        text: Tr.t("steam-downloads-about");
                        font-size: 13px;
                        color: Colors.dim;
                        wrap: word-wrap;
                    }
                    for item in DownloadsData.steam-rows: SteamLine { item: item; }
                }
            }

            // The job the engine is running.
            if DownloadsData.running: Rectangle {
                background: Colors.surface;
                border-width: 1px;
                border-color: Colors.line;
                height: now.preferred-height;
                now := VerticalLayout {
                    padding: Space.l;
                    spacing: Space.m;
                    HorizontalLayout {
                        spacing: Space.m;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: DownloadsData.current-title;
                                font-size: 18px;
                                font-weight: 700;
                                color: Colors.foreground;
                                overflow: elide;
                            }
                            Text {
                                text: DownloadsData.current-line;
                                font-size: 13px;
                                color: Colors.accent;
                                overflow: elide;
                            }
                        }
                        ActionButton {
                            label: DownloadsData.pause-label;
                            enabled: DownloadsData.pause-on;
                            clicked => { DownloadsData.pause("running"); }
                        }
                        ActionButton {
                            label: DownloadsData.cancel-label;
                            enabled: DownloadsData.cancel-on;
                            clicked => { DownloadsData.cancel("running"); }
                        }
                    }
                    // A bar at zero says stalled; with no percentage the line
                    // below already says the engine is starting.
                    Rectangle {
                        height: DownloadsData.percent >= 0 ? 8px : 0px;
                        background: Colors.raised;
                        Rectangle {
                            x: 0px;
                            width: parent.width * Math.min(DownloadsData.percent, 100) / 100;
                            background: Colors.accent;
                        }
                    }
                    Text {
                        text: DownloadsData.progress-line;
                        font-size: 13px;
                        color: Colors.dim;
                        wrap: word-wrap;
                    }
                }
            }

            if DownloadsData.up-next.length > 0: Heading {
                text: Tr.t("downloads-up-next").to-uppercase();
            }
            for job in DownloadsData.up-next: JobCard {
                job: job;
                kind: 0;
            }
            if DownloadsData.paused.length > 0: Heading {
                text: Tr.t("downloads-paused").to-uppercase();
            }
            for job in DownloadsData.paused: JobCard {
                job: job;
                kind: 1;
            }
            if DownloadsData.finished.length > 0: HorizontalLayout {
                Heading {
                    horizontal-stretch: 1;
                    text: Tr.t("downloads-finished").to-uppercase();
                    vertical-alignment: center;
                }
                ActionButton {
                    label: Tr.t("downloads-clear");
                    small: true;
                    clicked => { DownloadsData.clear(); }
                }
            }
            for job in DownloadsData.finished: JobCard {
                job: job;
                kind: 2;
            }

            if DownloadsData.invite: VerticalLayout {
                padding-top: 120px;
                spacing: Space.m;
                alignment: center;
                Text {
                    text: Tr.t("downloads-empty");
                    font-size: 18px;
                    color: Colors.foreground;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    ActionButton {
                        label: Tr.t("downloads-go-store");
                        clicked => { DownloadsData.go-store(); }
                    }
                }
            }
        }
    }
}
