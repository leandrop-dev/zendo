// The Settings page: groups of settings shown one at a time (chips at the
// top), each a card with a heading and a line about it. The Rust side
// (src/settings_ui.rs) fills `SettingsData`; nothing here holds a setting.

import { Colors, Space, Tr } from "style.slint";
import { ChipButton, ActionButton, TextField, Section, Toggle, Note, RowButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { ChipData } from "library.slint";
import { Fact } from "game.slint";

// A thing Settings lists with buttons: an engine, a runtime, a Proton or a
// release. Rust fills every text; an empty one is not drawn.
export struct SetRow {
    title: string,
    // A dim line under the title.
    sub: string,
    // The place on disk, in the mono face.
    path: string,
    // A small line: 0 dim, 1 good, 2 bad by `note-tone`.
    note: string,
    note-tone: int,
    // The main button (Download, Update to ...) and the Remove one.
    action: string,
    action-on: bool,
    remove: string,
    remove-on: bool,
    remove-danger: bool,
    // Words in place of a button ("Up to date", "Installed"): 1 good.
    status: string,
    status-tone: int,
}

// A download's progress: its name, the bytes so far and how far it is.
export struct Bar {
    active: bool,
    name: string,
    size: string,
    percent: float,
    stopping: bool,
}

export global SettingsData {
    // The groups' chips; `group` is the shown one's id.
    in property <[ChipData]> groups;
    in property <int> group;
    // General.
    in property <[ChipData]> languages;
    in property <bool> tray;
    in property <bool> opaque;
    in property <[ChipData]> themes;
    in property <string> theme-about;
    in property <string> theme-note;
    // 1 good, 2 bad, 3 dim.
    in property <int> theme-note-tone;
    in property <[string]> theme-problems;
    in property <bool> discord;
    // Engines.
    in property <bool> path-first;
    in property <[SetRow]> engines;
    in property <Bar> engines-bar;
    in property <string> engines-note;
    in property <int> engines-note-tone;
    in property <[SetRow]> runtimes;
    in property <string> runtimes-note;
    in property <int> runtimes-note-tone;
    in property <string> overlay-status;
    in property <string> overlay-install;
    in property <bool> overlay-install-on;
    in property <string> overlay-remove;
    in property <bool> overlay-remove-on;
    in property <string> overlay-note;
    in property <int> overlay-note-tone;
    // Proton.
    in property <[ChipData]> proton-defaults;
    in property <[SetRow]> proton-installed;
    in property <string> proton-installed-none;
    in property <[ChipData]> proton-builds;
    in property <string> proton-releases-title;
    in property <[SetRow]> proton-releases;
    in property <bool> proton-refresh-on;
    in property <string> proton-line;
    in property <int> proton-line-tone;
    in property <bool> proton-older;
    in property <Bar> proton-bar;
    in property <string> proton-note;
    in property <int> proton-note-tone;
    // Keys: SteamGridDB's.
    in-out property <string> key-value;
    in property <bool> key-shown;
    // 1 good, 2 bad, 3 dim; empty when there is nothing to say.
    in property <string> key-note;
    in property <int> key-tone;
    in property <bool> key-checking;
    in property <bool> key-changed;
    in property <string> key-kept;
    in property <bool> key-kept-bad;
    // Library.
    in property <bool> covers;
    in property <string> covers-progress;
    in property <bool> covers-now;
    in property <bool> auto-update;
    in property <[ChipData]> workers;
    in property <[Fact]> sources;
    // Diagnostics.
    in property <[Fact]> files;
    in property <bool> report-busy;
    in property <string> report-note;
    in property <int> report-tone;
    in property <bool> logs;

    callback group-chosen(int);
    callback language-chosen(int);
    callback set-tray(bool);
    callback set-opaque(bool);
    callback theme-chosen(int);
    callback set-discord(bool);
    callback set-path-first(bool);
    callback engines-check();
    callback engine-act(int);
    callback engine-remove(int);
    callback engines-stop();
    callback runtime-act(int);
    callback runtime-remove(int);
    callback overlay-do-install();
    callback overlay-do-remove();
    callback default-chosen(int);
    callback proton-remove(int);
    callback build-chosen(int);
    callback proton-refresh();
    callback proton-show-older();
    callback release-download(int);
    callback proton-stop();
    callback key-edited(string);
    callback key-toggle-shown();
    callback key-check();
    callback key-save();
    callback key-get();
    callback set-covers(bool);
    callback covers-download();
    callback set-auto-update(bool);
    callback workers-chosen(int);
    callback open(string);
    callback copy-report();
    callback open-logs();
    // The window's language changed: Rust writes its texts again.
    callback relabel();
}

// The things a card lists: a name, lines under it and the buttons beside it.
component SetList inherits VerticalLayout {
    in property <[SetRow]> rows;
    // The room inside the card.
    in property <length> inner;
    callback act(int);
    callback remove(int);
    spacing: Space.m;
    for row[index] in root.rows: HorizontalLayout {
        spacing: Space.m;
        // An explicit width, as a wrapped text measures its height at it;
        // what is left of the row is for the buttons.
        VerticalLayout {
            width: root.inner - 300px;
            spacing: 2px;
            Text {
                text: row.title;
                font-size: 14px;
                font-weight: 700;
                color: Colors.foreground;
                wrap: word-wrap;
            }
            Text {
                height: self.text == "" ? 0px : self.preferred-height;
                text: row.sub;
                font-size: 13px;
                color: Colors.dim;
                wrap: word-wrap;
            }
            Text {
                height: self.text == "" ? 0px : self.preferred-height;
                text: row.path;
                font-size: 12px;
                color: Colors.dim;
                wrap: word-wrap;
            }
            Text {
                height: self.text == "" ? 0px : self.preferred-height;
                text: row.note;
                font-size: 12px;
                color: row.note-tone == 1 ? Colors.good : row.note-tone == 2 ? Colors.bad : Colors.dim;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 0px;
            // As tall as a button, so the words sit on the buttons' line.
            Text {
                height: 28px;
                text: row.status;
                font-size: 13px;
                color: row.status-tone == 1 ? Colors.good : Colors.dim;
                vertical-alignment: center;
            }
            RowButton {
                label: row.action;
                enabled: row.action-on;
                clicked => { root.act(index); }
            }
            RowButton {
                label: row.remove;
                enabled: row.remove-on;
                danger: row.remove-danger;
                clicked => { root.remove(index); }
            }
        }
    }
}

// A download in progress: its name, the bytes so far, Stop and the bar.
component DownloadBar inherits VerticalLayout {
    in property <Bar> bar;
    callback stop();
    spacing: Space.s;
    height: root.bar.active ? self.preferred-height : 0px;
    visible: root.bar.active;
    HorizontalLayout {
        spacing: Space.m;
        Text {
            text: Tr.with("protons-downloading", "name", root.bar.name);
            font-size: 14px;
            color: Colors.foreground;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: root.bar.size;
            font-size: 13px;
            color: Colors.dim;
            vertical-alignment: center;
        }
        RowButton {
            label: root.bar.stopping ? Tr.t("stopping") : Tr.t("stop");
            enabled: !root.bar.stopping;
            clicked => { root.stop(); }
        }
    }
    Rectangle {
        height: 8px;
        background: Colors.raised;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.bar.percent, 0, 100) / 100;
            background: Colors.accent;
        }
    }
}

export component SettingsPage inherits Rectangle {
    // The room inside a card: the column's width less the page's padding
    // and the card's own.
    property <length> inner: min(960px, root.width - 12px) - 2 * Space.xl - 2 * Space.l;
    VerticalLayout {
        FlexboxLayout {
            vertical-stretch: 0;
            cross-axis-alignment: start;
            cross-axis-line-alignment: start;
            padding-left: Space.xl;
            padding-right: Space.xl;
            padding-top: Space.xs;
            padding-bottom: Space.xs;
            spacing: Space.s;
            for chip in SettingsData.groups: ChipButton {
                label: chip.label;
                chosen: chip.chosen;
                clicked => { SettingsData.group-chosen(chip.id); }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(960px, root.width - 12px);
                    padding: Space.xl;
                    spacing: Space.l;
                    alignment: start;

                    // General.
                    if SettingsData.group == 0: Section {
                        heading: Tr.t("language-title");
                        about: Tr.t("language-about");
                        FlexboxLayout {
                            vertical-stretch: 0;
                            cross-axis-alignment: start;
                            cross-axis-line-alignment: start;
                            spacing: Space.s;
                            for chip in SettingsData.languages: ChipButton {
                                label: chip.label;
                                chosen: chip.chosen;
                                clicked => { SettingsData.language-chosen(chip.id); }
                            }
                        }
                    }
                    if SettingsData.group == 0: Section {
                        heading: Tr.t("theme-title");
                        about: SettingsData.theme-about;
                        VerticalLayout {
                            spacing: Space.m;
                            FlexboxLayout {
                                vertical-stretch: 0;
                                cross-axis-alignment: start;
                                cross-axis-line-alignment: start;
                                spacing: Space.s;
                                for chip in SettingsData.themes: ChipButton {
                                    label: chip.label;
                                    chosen: chip.chosen;
                                    clicked => { SettingsData.theme-chosen(chip.id); }
                                }
                            }
                            if SettingsData.theme-note != "": Note {
                                text: SettingsData.theme-note;
                                tone: SettingsData.theme-note-tone;
                            }
                            for problem in SettingsData.theme-problems: Note {
                                text: problem;
                                tone: 2;
                            }
                            Toggle {
                                label: Tr.t("theme-opaque");
                                on: SettingsData.opaque;
                                toggled(on) => { SettingsData.set-opaque(on); }
                            }
                        }
                    }
                    if SettingsData.group == 0: Section {
                        heading: Tr.t("window-title");
                        about: Tr.t("window-about");
                        Toggle {
                            label: Tr.t("minimize-to-tray");
                            on: SettingsData.tray;
                            toggled(on) => { SettingsData.set-tray(on); }
                        }
                    }
                    if SettingsData.group == 0: Section {
                        heading: Tr.t("discord-title");
                        about: Tr.t("discord-about");
                        Toggle {
                            label: Tr.t("discord-presence");
                            on: SettingsData.discord;
                            toggled(on) => { SettingsData.set-discord(on); }
                        }
                    }

                    // Keys.
                    if SettingsData.group == 1: Section {
                        heading: "SteamGridDB";
                        about: Tr.t("steamgriddb-about");
                        VerticalLayout {
                            spacing: Space.m;
                            HorizontalLayout {
                                spacing: Space.s;
                                TextField {
                                    horizontal-stretch: 1;
                                    placeholder: Tr.t("steamgriddb-paste");
                                    password: !SettingsData.key-shown;
                                    text <=> SettingsData.key-value;
                                    edited(typed) => { SettingsData.key-edited(typed); }
                                    accepted => { SettingsData.key-save(); }
                                }
                                ActionButton {
                                    label: SettingsData.key-shown ? Tr.t("key-hide") : Tr.t("key-show");
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.key-toggle-shown(); }
                                }
                                ActionButton {
                                    label: SettingsData.key-checking ? Tr.t("key-checking") : Tr.t("key-check");
                                    enabled: !SettingsData.key-checking && SettingsData.key-value != "";
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.key-check(); }
                                }
                                ActionButton {
                                    label: Tr.t("key-save");
                                    primary: true;
                                    enabled: SettingsData.key-changed;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.key-save(); }
                                }
                            }
                            if SettingsData.key-note != "": Note {
                                text: SettingsData.key-note;
                                tone: SettingsData.key-tone;
                            }
                            if SettingsData.key-kept != "": Note {
                                text: SettingsData.key-kept;
                                tone: SettingsData.key-kept-bad ? 2 : 3;
                            }
                            Rectangle {
                                height: get-key.preferred-height;
                                get-key := Text {
                                    x: 0;
                                    text: Tr.t("steamgriddb-get-key");
                                    font-size: 13px;
                                    color: get-touch.has-hover ? Colors.accent : Colors.foreground;
                                }
                                get-touch := TouchArea {
                                    x: 0;
                                    mouse-cursor: pointer;
                                    width: get-key.preferred-width;
                                    clicked => { SettingsData.key-get(); }
                                }
                            }
                        }
                    }

                    // Library.
                    if SettingsData.group == 2: Section {
                        heading: Tr.t("covers-title");
                        about: Tr.t("covers-about");
                        VerticalLayout {
                            spacing: Space.l;
                            Toggle {
                                label: Tr.t("covers-download");
                                on: SettingsData.covers;
                                toggled(on) => { SettingsData.set-covers(on); }
                            }
                            HorizontalLayout {
                                spacing: Space.m;
                                alignment: start;
                                ActionButton {
                                    label: Tr.t("covers-download-now");
                                    enabled: SettingsData.covers-now;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.covers-download(); }
                                }
                                Text {
                                    text: SettingsData.covers-progress;
                                    font-size: 13px;
                                    color: Colors.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if SettingsData.group == 2: Section {
                        heading: Tr.t("downloads-settings-title");
                        about: Tr.t("downloads-settings-about");
                        VerticalLayout {
                            spacing: Space.l;
                            Toggle {
                                label: Tr.t("auto-update");
                                on: SettingsData.auto-update;
                                toggled(on) => { SettingsData.set-auto-update(on); }
                            }
                            VerticalLayout {
                                spacing: Space.s;
                                Text {
                                    text: Tr.t("workers-title");
                                    font-size: 14px;
                                    color: Colors.foreground;
                                }
                                FlexboxLayout {
                                    vertical-stretch: 0;
                                    cross-axis-alignment: start;
                                    cross-axis-line-alignment: start;
                                    spacing: Space.s;
                                    for chip in SettingsData.workers: ChipButton {
                                        label: chip.label;
                                        chosen: chip.chosen;
                                        clicked => { SettingsData.workers-chosen(chip.id); }
                                    }
                                }
                                Text {
                                    text: Tr.t("workers-about");
                                    font-size: 13px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    if SettingsData.group == 2: Section {
                        heading: Tr.t("sources-title");
                        about: Tr.t("sources-about");
                        VerticalLayout {
                            spacing: Space.s;
                            for source in SettingsData.sources: HorizontalLayout {
                                spacing: Space.m;
                                Text {
                                    width: 220px;
                                    text: source.label;
                                    font-size: 14px;
                                    color: Colors.foreground;
                                    wrap: word-wrap;
                                }
                                Text {
                                    width: root.inner - 220px - Space.m;
                                    text: source.value;
                                    font-size: source.tone == 2 ? 13px : 14px;
                                    color: source.tone == 2 ? Colors.bad : source.tone == 3 ? Colors.dim : Colors.foreground;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // Engines.
                    if SettingsData.group == 3: Section {
                        heading: Tr.t("engines-title");
                        about: Tr.t("engines-about");
                        VerticalLayout {
                            spacing: Space.m;
                            Toggle {
                                label: Tr.t("engines-path-first");
                                on: SettingsData.path-first;
                                toggled(on) => { SettingsData.set-path-first(on); }
                            }
                            HorizontalLayout {
                                alignment: start;
                                ActionButton {
                                    label: Tr.t("protons-check-again");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.engines-check(); }
                                }
                            }
                            SetList {
                                rows: SettingsData.engines;
                                inner: root.inner;
                                act(index) => { SettingsData.engine-act(index); }
                                remove(index) => { SettingsData.engine-remove(index); }
                            }
                            DownloadBar {
                                bar: SettingsData.engines-bar;
                                stop => { SettingsData.engines-stop(); }
                            }
                            if SettingsData.engines-note != "": Note {
                                text: SettingsData.engines-note;
                                tone: SettingsData.engines-note-tone;
                            }
                        }
                    }
                    if SettingsData.group == 3: Section {
                        heading: Tr.t("runtimes-title");
                        about: Tr.t("runtimes-about");
                        VerticalLayout {
                            spacing: Space.m;
                            SetList {
                                rows: SettingsData.runtimes;
                                inner: root.inner;
                                act(index) => { SettingsData.runtime-act(index); }
                                remove(index) => { SettingsData.runtime-remove(index); }
                            }
                            if SettingsData.runtimes-note != "": Note {
                                text: SettingsData.runtimes-note;
                                tone: SettingsData.runtimes-note-tone;
                            }
                        }
                    }
                    if SettingsData.group == 3: Section {
                        heading: Tr.t("overlay-title");
                        about: Tr.t("overlay-about");
                        VerticalLayout {
                            spacing: Space.m;
                            Note {
                                width: root.inner;
                                text: SettingsData.overlay-status;
                                tone: 3;
                            }
                            HorizontalLayout {
                                spacing: Space.s;
                                alignment: start;
                                ActionButton {
                                    label: SettingsData.overlay-install;
                                    enabled: SettingsData.overlay-install-on;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.overlay-do-install(); }
                                }
                                if SettingsData.overlay-remove != "": ActionButton {
                                    label: SettingsData.overlay-remove;
                                    enabled: SettingsData.overlay-remove-on;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.overlay-do-remove(); }
                                }
                            }
                            if SettingsData.overlay-note != "": Note {
                                text: SettingsData.overlay-note;
                                tone: SettingsData.overlay-note-tone;
                            }
                        }
                    }

                    // Proton.
                    if SettingsData.group == 4: Section {
                        heading: "Proton";
                        about: Tr.t("protons-about");
                        VerticalLayout {
                            spacing: Space.m;
                            Text {
                                text: Tr.t("protons-default");
                                font-size: 14px;
                                font-weight: 700;
                                color: Colors.foreground;
                            }
                            Text {
                                width: root.inner;
                                text: Tr.t("protons-default-about");
                                font-size: 13px;
                                color: Colors.dim;
                                wrap: word-wrap;
                            }
                            FlexboxLayout {
                                vertical-stretch: 0;
                                cross-axis-alignment: start;
                                cross-axis-line-alignment: start;
                                spacing: Space.s;
                                for chip in SettingsData.proton-defaults: ChipButton {
                                    label: chip.label;
                                    chosen: chip.chosen;
                                    clicked => { SettingsData.default-chosen(chip.id); }
                                }
                            }
                            Text {
                                text: Tr.t("protons-here");
                                font-size: 14px;
                                font-weight: 700;
                                color: Colors.foreground;
                            }
                            Text {
                                width: root.inner;
                                height: self.text == "" ? 0px : self.preferred-height;
                                text: SettingsData.proton-installed-none;
                                font-size: 14px;
                                color: Colors.dim;
                                wrap: word-wrap;
                            }
                            SetList {
                                rows: SettingsData.proton-installed;
                                inner: root.inner;
                                remove(index) => { SettingsData.proton-remove(index); }
                            }
                            Text {
                                text: SettingsData.proton-releases-title;
                                font-size: 14px;
                                font-weight: 700;
                                color: Colors.foreground;
                            }
                            FlexboxLayout {
                                vertical-stretch: 0;
                                cross-axis-alignment: start;
                                cross-axis-line-alignment: start;
                                spacing: Space.s;
                                for chip in SettingsData.proton-builds: ChipButton {
                                    label: chip.label;
                                    chosen: chip.chosen;
                                    clicked => { SettingsData.build-chosen(chip.id); }
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                ActionButton {
                                    label: Tr.t("protons-check-again");
                                    small: true;
                                    enabled: SettingsData.proton-refresh-on;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.proton-refresh(); }
                                }
                            }
                            SetList {
                                rows: SettingsData.proton-releases;
                                inner: root.inner;
                                act(index) => { SettingsData.release-download(index); }
                            }
                            if SettingsData.proton-line != "": Note {
                                width: root.inner;
                                text: SettingsData.proton-line;
                                tone: SettingsData.proton-line-tone;
                            }
                            if SettingsData.proton-older: HorizontalLayout {
                                alignment: start;
                                ActionButton {
                                    label: Tr.t("protons-show-older");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.proton-show-older(); }
                                }
                            }
                            DownloadBar {
                                bar: SettingsData.proton-bar;
                                stop => { SettingsData.proton-stop(); }
                            }
                            if SettingsData.proton-note != "": Note {
                                width: root.inner;
                                text: SettingsData.proton-note;
                                tone: SettingsData.proton-note-tone;
                            }
                        }
                    }

                    // Diagnostics.
                    if SettingsData.group == 5: Section {
                        heading: Tr.t("files-title");
                        about: Tr.t("files-about");
                        VerticalLayout {
                            spacing: Space.m;
                            for file in SettingsData.files: HorizontalLayout {
                                spacing: Space.m;
                                Text {
                                    width: 160px;
                                    text: file.label;
                                    font-size: 14px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                                Text {
                                    width: root.inner - 160px - 110px - 2 * Space.m;
                                    text: file.value;
                                    font-size: 13px;
                                    color: Colors.foreground;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Tr.t("files-open-folder");
                                    small: true;
                                    enabled: file.path;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.open(file.url); }
                                }
                            }
                        }
                    }
                    if SettingsData.group == 5: Section {
                        heading: Tr.t("report-title");
                        about: Tr.t("report-about");
                        VerticalLayout {
                            spacing: Space.m;
                            HorizontalLayout {
                                spacing: Space.s;
                                alignment: start;
                                ActionButton {
                                    label: SettingsData.report-busy ? Tr.t("report-gathering") : Tr.t("report-copy");
                                    primary: true;
                                    enabled: !SettingsData.report-busy;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.copy-report(); }
                                }
                                ActionButton {
                                    label: Tr.t("report-open-logs");
                                    enabled: SettingsData.logs;
                                    horizontal-stretch: 0;
                                    clicked => { SettingsData.open-logs(); }
                                }
                            }
                            if SettingsData.report-note != "": Note {
                                text: SettingsData.report-note;
                                tone: SettingsData.report-tone;
                            }
                        }
                    }
                }
            }
        }
    }
}
