// The Accounts page: Zendo's own sign-ins to Epic, GOG and Amazon. A card per
// store, with who is signed in, the engine that does it and, while a sign-in
// is under way, its steps. The Rust side (src/accounts_ui.rs) holds the
// sign-ins; nothing here keeps one.

import { Colors, Space, Tr } from "style.slint";
import { ActionButton, TextField, Toggle, Note } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One store's card, with every text it shows.
export struct AccountCard {
    badge: string,
    title: string,
    // The sign-in's state in words, and its colour: 0 dim, 1 good, 2 bad.
    status: string,
    status-tone: int,
    // The engine's path, or that it is missing; empty while it is looked for.
    engine: string,
    engine-ok: bool,
    // Sign in (0) or Sign out (1), and whether it can be pressed.
    action: string,
    action-kind: int,
    action-on: bool,
    // GOG, signed in: its two switches.
    gog: bool,
    // The sign-in under way: 0 none, 1 in Zendo's window, 2 in the browser.
    flow: int,
    line: string,
    note: string,
    retry: bool,
    browser-on: bool,
    step-one: string,
    step-two: string,
    step-three: string,
    open-label: string,
    open-on: bool,
    finish-label: string,
    finish-on: bool,
}

export global AccountsData {
    in property <[AccountCard]> cards;
    in property <bool> gog-playtime;
    in property <bool> gog-galaxy;
    in-out property <string> code;
    // Rust counts these up to put the keyboard in the code field, or to paste
    // into it.
    in property <int> focus-code;
    in property <int> paste-code;

    callback start(int);
    callback sign-out(int);
    callback cancel();
    callback use-browser();
    callback open-page();
    callback code-edited(string);
    callback finish();
    callback set-gog-playtime(bool);
    callback set-gog-galaxy(bool);
    // The window's language changed: Rust writes its texts again.
    callback relabel();
}

// The sign-in in the user's browser, finished by pasting.
component BrowserSteps inherits VerticalLayout {
    in property <AccountCard> card;
    in property <length> inner;
    property <int> focus-tick: AccountsData.focus-code;
    changed focus-tick => { code-field.focus-end(); }
    property <int> paste-tick: AccountsData.paste-code;
    changed paste-tick => { code-field.paste-text(); }
    spacing: Space.m;
    padding-top: Space.m;
    padding-bottom: Space.m;
    HorizontalLayout {
        spacing: Space.m;
        alignment: start;
        Text {
            text: root.card.step-one;
            font-size: 14px;
            color: Colors.foreground;
            vertical-alignment: center;
        }
        ActionButton {
            label: root.card.open-label;
            small: true;
            enabled: root.card.open-on;
            clicked => { AccountsData.open-page(); }
        }
    }
    Text {
        width: root.inner;
        text: root.card.step-two;
        font-size: 14px;
        color: Colors.foreground;
        wrap: word-wrap;
    }
    Text {
        width: root.inner;
        text: root.card.step-three;
        font-size: 14px;
        color: Colors.foreground;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: Space.s;
        code-field := TextField {
            horizontal-stretch: 1;
            text <=> AccountsData.code;
            placeholder: Tr.t("accounts-paste-here");
            edited(text) => { AccountsData.code-edited(text); }
            accepted => { AccountsData.finish(); }
        }
        ActionButton {
            label: root.card.finish-label;
            primary: true;
            enabled: root.card.finish-on;
            clicked => { AccountsData.finish(); }
        }
        ActionButton {
            label: Tr.t("cancel");
            clicked => { AccountsData.cancel(); }
        }
    }
    if root.card.note != "": Note {
        width: root.inner;
        text: root.card.note;
        tone: 2;
    }
}

component Card inherits Rectangle {
    in property <AccountCard> card;
    in property <int> index;
    in property <length> inner;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;

    VerticalLayout {
        padding: Space.l;
        spacing: Space.s;
        HorizontalLayout {
            spacing: Space.m;
            Rectangle {
                width: badge.preferred-width + 2 * Space.s;
                height: 22px;
                y: 3px;
                border-width: 1px;
                border-color: Colors.accent;
                badge := Text {
                    text: root.card.badge;
                    font-size: 11px;
                    font-weight: 700;
                    color: Colors.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.card.title;
                font-size: 16px;
                font-weight: 700;
                color: Colors.foreground;
                vertical-alignment: center;
            }
            ActionButton {
                label: root.card.action;
                primary: root.card.action-kind == 0;
                enabled: root.card.action-on;
                clicked => {
                    if root.card.action-kind == 0 { AccountsData.start(root.index); } else { AccountsData.sign-out(root.index); }
                }
            }
        }
        Text {
            width: root.inner;
            text: root.card.status;
            font-size: 14px;
            color: root.card.status-tone == 1 ? Colors.good : root.card.status-tone == 2 ? Colors.bad : Colors.dim;
            wrap: word-wrap;
        }
        Text {
            width: root.inner;
            text: root.card.engine;
            font-size: root.card.engine-ok ? 12px : 13px;
            font-family: root.card.engine-ok ? "JetBrains Mono" : "";
            color: root.card.engine-ok ? Colors.dim : Colors.bad;
            wrap: word-wrap;
        }
        if root.card.gog: VerticalLayout {
            spacing: Space.s;
            padding-top: Space.s;
            Toggle {
                label: Tr.t("accounts-gog-playtime");
                on: AccountsData.gog-playtime;
                toggled(on) => { AccountsData.set-gog-playtime(on); }
            }
            Toggle {
                label: Tr.t("accounts-gog-galaxy");
                on: AccountsData.gog-galaxy;
                toggled(on) => { AccountsData.set-gog-galaxy(on); }
            }
        }
        // In Zendo's window: what it waits on, and a way out to the browser.
        if root.card.flow == 1: VerticalLayout {
            spacing: Space.m;
            padding-top: Space.m;
            padding-bottom: Space.m;
            if root.card.line != "": Text {
                width: root.inner;
                text: root.card.line;
                font-size: 14px;
                color: Colors.foreground;
                wrap: word-wrap;
            }
            if root.card.note != "": Note {
                width: root.inner;
                text: root.card.note;
                tone: 2;
            }
            HorizontalLayout {
                spacing: Space.s;
                alignment: start;
                if root.card.retry: ActionButton {
                    label: Tr.t("try-again");
                    primary: true;
                    clicked => { AccountsData.start(root.index); }
                }
                ActionButton {
                    label: Tr.t("accounts-use-browser");
                    enabled: root.card.browser-on;
                    clicked => { AccountsData.use-browser(); }
                }
                ActionButton {
                    label: Tr.t("cancel");
                    clicked => { AccountsData.cancel(); }
                }
            }
        }
        // In the user's browser, finished by pasting.
        if root.card.flow == 2: BrowserSteps {
            card: root.card;
            inner: root.inner;
        }
    }
}

export component AccountsPage inherits Rectangle {
    property <length> column: min(960px, root.width - 12px);
    // The room inside a card: the column less the page's padding and the card's.
    property <length> inner: root.column - 2 * Space.xl - 2 * Space.l;
    ScrollView {
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: root.column;
                padding: Space.xl;
                spacing: Space.l;
                alignment: start;

                Rectangle {
                    background: Colors.surface;
                    border-width: 1px;
                    border-color: Colors.line;
                    VerticalLayout {
                        padding: Space.l;
                        Text {
                            width: root.inner;
                            text: Tr.t("accounts-about");
                            font-size: 13px;
                            color: Colors.dim;
                            wrap: word-wrap;
                        }
                    }
                }
                Card { index: 0; card: AccountsData.cards[0]; inner: root.inner; }
                Card { index: 1; card: AccountsData.cards[1]; inner: root.inner; }
                Card { index: 2; card: AccountsData.cards[2]; inner: root.inner; }
            }
        }
    }
}
