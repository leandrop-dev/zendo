// Zendo's window, in Slint. The pages come one item at a time (docs/backlog.md,
// items 48 to 53); until then each shows its name.

import "../../zendo/fonts/JetBrainsMono-Regular.ttf";
import "../../zendo/fonts/JetBrainsMono-Bold.ttf";
import { Colors, Space, Tr } from "style.slint";
import { TopBar, SettingsTabs, Page } from "top_bar.slint";
import { GamePage, GameData, Tile, Fact, OwnedBadge, DlcRow } from "game.slint";
import { StorePage, StoreData } from "store.slint";
import { DownloadsPage, DownloadsData, JobRow, SteamRow } from "downloads.slint";
import { LocalSheet, LocalData } from "local_form.slint";
import { OptionsSheet, OptionsData, OptSwitch } from "launch_options.slint";
import { ArtSheet, ArtData, ArtThumb } from "artwork.slint";
import { CollectionsSheet, CollectionsData, CollRow } from "collections.slint";
import { SettingsPage, SettingsData, SetRow, Bar } from "settings.slint";
import { AboutPage, AboutData } from "about.slint";
import { AccountsPage, AccountsData, AccountCard, SteamCardData } from "accounts.slint";
import { LibraryPage, LibraryData, Card, CardRow, ChipData, Grid } from "library.slint";

// Rust reaches the globals, the structs and the enum through these.
export { Colors, Space, Tr, Page, LibraryData, Card, CardRow, ChipData, Grid, GameData, Tile, Fact, OwnedBadge, StoreData, DownloadsData, JobRow, SteamRow, DlcRow, LocalData, SettingsData, SetRow, Bar, AboutData, CollectionsData, CollRow, OptionsData, OptSwitch, ArtData, ArtThumb, AccountsData, AccountCard, SteamCardData }

export component MainWindow inherits Window {
    title: "Zendo";
    min-width: 1100px;
    min-height: 560px;
    preferred-width: 1360px;
    preferred-height: 860px;
    default-font-family: "JetBrains Mono";
    default-font-size: 14px;
    // Translucent unless Settings asks for an opaque window: the compositor
    // shows the desktop through it (blurred, for the class `zendo`).
    background: Colors.background.with-alpha(root.translucency);
    forward-focus: scope;

    in-out property <Page> page: Page.library;
    // How much of the window is paint: 1 is opaque.
    in property <float> translucency: 2.0 / 3.0;
    in property <string> library-count;
    in property <string> store-count;
    in property <string> downloads-count;
    // How many stores are signed in, beside Accounts under Settings.
    in property <string> accounts-count;
    // The page's name, in the window's language, for the page area until the
    // pages arrive.
    out property <string> page-title:
        root.page == Page.library ? Tr.t("page-library")
        : root.page == Page.store ? Tr.t("page-store")
        : root.page == Page.stats ? Tr.t("page-stats")
        : root.page == Page.downloads ? Tr.t("page-downloads")
        : root.page == Page.accounts ? Tr.t("page-accounts")
        : root.page == Page.about ? Tr.t("page-about")
        : Tr.t("page-settings");

    // A tab or icon button was pressed: Rust changes the page, so what the
    // old one held (marks, an open game, its message) is let go.
    callback page-requested(Page);

    // Texts Rust writes (the chips, the cards' lines) do not read `Tr.language`,
    // so a change of language asks for them again.
    property <int> language: Tr.language;
    changed language => {
        LibraryData.relabel();
        StoreData.relabel();
        DownloadsData.relabel();
        SettingsData.relabel();
        CollectionsData.relabel();
        AccountsData.relabel();
    }

    // Ctrl+F and Ctrl+V.
    public function focus-search() { top-bar.focus-search(); }
    public function paste-search() { top-bar.paste-search(); }
    // Takes the keyboard back from the search field, so the arrows move the
    // cursor in the grid again.
    public function focus-page() { scope.focus(); }

    scope := FocusScope {
        // Escape before a focused field can keep it.
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                LibraryData.back();
                scope.focus();
                return accept;
            }
            reject
        }
        // Whatever the search field did not use.
        key-pressed(event) => {
            LibraryData.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.meta, event.modifiers.shift) ? accept : reject
        }

        VerticalLayout {
            top-bar := TopBar {
                // Above the page, so the icon buttons' tooltips draw over it.
                z: 1;
                page: root.page;
                library-count: root.library-count;
                store-count: root.store-count;
                downloads-count: root.downloads-count;
                navigate(page) => { root.page-requested(page); }
            }
            if root.page == Page.settings || root.page == Page.accounts || root.page == Page.about: SettingsTabs {
                z: 1;
                vertical-stretch: 0;
                page: root.page;
                accounts-count: root.accounts-count;
                navigate(page) => { root.page-requested(page); }
            }
            if root.page == Page.library && !GameData.open: LibraryPage { }
            if root.page == Page.library && GameData.open: GamePage {
                vertical-stretch: 1;
            }
            if root.page == Page.settings: SettingsPage {
                vertical-stretch: 1;
            }
            if root.page == Page.about: AboutPage {
                vertical-stretch: 1;
            }
            if root.page == Page.accounts: AccountsPage {
                vertical-stretch: 1;
            }
            if root.page == Page.store && !GameData.open: StorePage { }
            if root.page == Page.store && GameData.open: GamePage {
                vertical-stretch: 1;
            }
            if root.page == Page.downloads: DownloadsPage {
                vertical-stretch: 1;
            }
            if root.page == Page.stats: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: root.page-title.to-uppercase();
                    font-size: 20px;
                    font-weight: 700;
                    color: Colors.dim;
                }
            }
            // The footer: what Zendo says, and the keys.
            HorizontalLayout {
                padding-left: Space.xl;
                padding-right: Space.xl;
                padding-top: Space.s;
                padding-bottom: Space.s;
                spacing: Space.l;
                Text {
                    horizontal-stretch: 1;
                    text: LibraryData.status;
                    font-size: 13px;
                    color: Colors.dim;
                    overflow: elide;
                }
                Text {
                    text: ArtData.open ? Tr.t("hints-art")
                        : OptionsData.open ? Tr.t("hints-sheet")
                        : root.page == Page.library ? (GameData.open ? Tr.t("hints-game") : LibraryData.hints)
                        : root.page == Page.store ? (GameData.open ? Tr.t("hints-owned") : Tr.t("hints-store"))
                        : root.page == Page.downloads && DownloadsData.asking ? Tr.t("hints-closing")
                        : Tr.t("hints-other");
                    font-size: 13px;
                    color: Colors.dim;
                }
            }
        }
        // The Add game sheet, over everything and first to hear Escape.
        if CollectionsData.open: CollectionsSheet {
            width: 100%;
            height: 100%;
        }
        if LocalData.open: LocalSheet {
            width: 100%;
            height: 100%;
        }
        if OptionsData.open: OptionsSheet {
            width: 100%;
            height: 100%;
        }
        if ArtData.open: ArtSheet {
            width: 100%;
            height: 100%;
        }
    }
}
