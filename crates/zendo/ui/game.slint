// A game's page: its wide art faint behind the header, the cover, the title
// and badges, one bar of actions, the status chips, four tiles, then the
// sessions and the details. The Rust side (src/game_ui.rs) fills `GameData`;
// nothing here holds a game.

import { Colors, Space, Tr } from "style.slint";
import { ChipButton, ActionButton, RowButton, TextField, CheckBox } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { ChipData } from "library.slint";
import { ModsData } from "mods.slint";
import { DownloadLine } from "nexus.slint";

export struct Tile {
    label: string,
    value: string,
}

// A label and its value in the details card; `path` says the value is a
// folder or file that can be opened.
export struct Fact {
    label: string,
    value: string,
    path: bool,
    mono: bool,
    // The value opens this link, when there is one.
    url: string,
    // The value's colour: 0 plain, 1 good, 2 bad, 3 dim, 4 accent.
    tone: int,
}

// A badge on the header that opens a page: ProtonDB's rating, say.
export struct Pill {
    label: string,
    tint: color,
    // 0 takes `tint`; 1, 2 and 3 take the theme's good, bad and dim.
    tone: int,
    // What it says on hover.
    tip: string,
    url: string,
}

// A screenshot: its small picture, and the address of the full one.
export struct Shot {
    thumb: image,
    ready: bool,
    full: string,
}

// A line of GOG's changelog: 0 an update's title, 1 a heading, 2 a paragraph,
// 3 a list item, 4 a gap between updates.
export struct Line {
    kind: int,
    text: string,
}

// A line of the system requirements.
export struct Req {
    label: string,
    minimum: string,
    recommended: string,
}

export struct Ach {
    icon: image,
    has-icon: bool,
    name: string,
    description: string,
    // When it was unlocked or how rare it is.
    side: string,
    unlocked: bool,
}

// A DLC in its card: its name and what it is (a size, "Comes with the game"),
// then its button, or what it is instead of one. An empty label is no button.
export struct DlcRow {
    id: string,
    title: string,
    about: string,
    label: string,
    // Uninstall pressed once: pressed again, it goes.
    danger: bool,
    enabled: bool,
    // "Installed" or "Not installed", where there is no button.
    status: string,
    // 1 good, 3 dim.
    status-tone: int,
}

// A badge under the title of a store game: a platform, or Installed.
export struct OwnedBadge {
    label: string,
    good: bool,
}

export global GameData {
    // The page is a store game's (the Store page's, with what the store says),
    // not a game of the library: no Play, status, collections or sessions.
    in property <bool> owned;
    in property <bool> owned-installed;
    // What installing it would do, in words, beside Open in library.
    in property <string> owned-note;
    in property <[OwnedBadge]> owned-badges;
    // What the queue holds of it: 0 nothing to press, 1 it can be installed,
    // 2 queued, 3 running, 4 paused. A Steam game: 5 Install with Steam,
    // 6 asked of Steam (ask again, Stop waiting), 7 Steam is on it.
    in property <int> owned-job;
    // What the running job is doing, as a button says it: "Installing". For
    // a Steam game, the main button's words in states 5 to 7.
    in property <string> owned-job-label;
    // Steam's progress, 0 to 100, or -1 for no bar.
    in property <float> owned-progress: -1;
    callback owned-forget();
    // "Also install its DLC", with how many; empty when it has none to give.
    in property <string> owned-dlc;
    in property <bool> owned-dlc-on;
    callback open-library();
    callback owned-install();
    callback owned-import();
    callback owned-resume();
    callback owned-downloads();
    callback owned-toggle-dlc();
    // Whether a game's page replaces the Library's grid.
    in-out property <bool> open;
    in property <string> title;
    in property <string> source-line;
    in property <image> cover;
    in property <bool> has-cover;
    in property <image> backdrop;
    in property <bool> has-backdrop;
    in property <string> favorite-badge;
    // "UPDATE AVAILABLE" while the queue has an update for this game; empty
    // otherwise.
    in property <string> update-badge;
    in property <string> hidden-badge;
    in property <bool> pinned;
    in property <bool> hidden;
    in property <bool> steam;
    // A game added by hand: Edit and Remove, and Remove pressed once.
    in property <bool> local;
    in property <bool> confirm-remove;
    // 0 Play, 1 Starting, 2 Running, 3 Stopping.
    in property <int> run-state;
    in property <string> line;
    in property <[ChipData]> statuses;
    // The collections the game is in, by name.
    in property <[string]> collections;
    in property <[Tile]> tiles;
    in property <[Fact]> sessions;
    in property <[Fact]> recent;
    in property <[Fact]> details;
    in property <[Fact]> technical;
    in property <bool> technical-open;
    in property <[Pill]> pills;
    // What the store says the game is about, empty when nothing does.
    in property <string> about;
    // No Steam game was found for it: the card that offers the way to give one.
    in property <string> no-match;
    in property <[Shot]> shots;
    in property <string> dlc-count;
    in property <[DlcRow]> dlc;
    // Install all, when more than one can be installed; empty is no button.
    in property <string> dlc-install-all;
    in property <bool> dlc-install-all-on;
    // Why Zendo cannot manage these: sign in, or Heroic does.
    in property <string> dlc-note;
    callback dlc-action(string);
    callback dlc-all();

    // The installed game's jobs. Update, when one waits (empty: no button).
    in property <string> update-label;
    in property <bool> update-on;
    callback update();
    // More: the row of less used actions, folded on each game.
    in property <bool> has-more;
    in property <bool> more-open;
    callback toggle-more();
    // The queue has a job for the game: the line says which, with See downloads.
    in property <bool> job-shown;
    callback see-downloads();
    // A game Zendo installed: Check for updates, Repair, Move and Uninstall.
    in property <bool> managed;
    in property <bool> check-on;
    // No job queued for the game: Repair, Move and Uninstall may be pressed.
    in property <bool> job-free;
    in property <bool> move-on;
    // Uninstall pressed once: pressed again, the files go.
    in property <bool> uninstall-again;
    // A Steam game: Verify and Uninstall, asked of Steam.
    in property <string> steam-verify-label;
    in property <bool> steam-verify-on;
    in property <string> steam-uninstall-label;
    callback check-updates();
    callback repair();
    callback move-game();
    callback uninstall();
    callback steam-verify();
    callback steam-uninstall();
    in property <string> ach-summary;
    // The share unlocked, 0 to 1, or -1 when the store did not say.
    in property <float> ach-share: -1;
    in property <[Ach]> ach;
    // "Show 12 more", or empty.
    in property <string> ach-more;
    in property <string> req-source;
    in property <bool> req-both;
    in property <[Req]> req;
    // Cards that could not be asked: the card's name and why.
    in property <[Fact]> failures;
    // The Anti-cheat card: shown first when the game will not play online.
    in property <bool> ac-show;
    in property <bool> ac-first;
    in property <string> ac-label;
    // 1 good, 2 bad, 3 dim.
    in property <int> ac-tone;
    in property <string> ac-makers;
    in property <string> ac-about;
    // The list's notes: the words in `label`, the source in `url`.
    in property <[Fact]> ac-notes;
    in property <string> ac-url;
    // The Wine prefix card, for a Windows game Zendo starts.
    in property <bool> prefix-show;
    // No tool runs in the prefix and the game does not.
    in property <bool> prefix-free;
    in property <bool> prefix-gog;
    // The prefix's folder, empty when it is not there yet.
    in property <string> prefix-folder;
    in-out property <string> prefix-components;
    in property <[Fact]> prefix-fixes;
    in property <string> prefix-status;
    // 1 good, 2 bad, 3 dim.
    in property <int> prefix-status-tone;
    // GOG's changelog.
    in property <[Line]> changelog;
    in property <string> changelog-more;
    // The Technical card's Steam app id row.
    in property <bool> steam-app-row;
    in property <string> steam-app-line;
    in-out property <string> steam-app-input;
    // Asked for by Rust (one more each time): scroll the page to its end.
    in-out property <int> scroll-end;
    in property <bool> steam-app-clearable;

    callback back();
    callback play();
    callback stop();
    callback toggle-pinned();
    callback toggle-hidden();
    callback manage-steam();
    callback wiki();
    callback status(int);
    callback edit-collections();
    callback open-path(string);
    callback toggle-technical();
    callback edit();
    callback remove();
    // The Launch options button: for the games Zendo starts itself.
    in property <bool> launch-options-shown;
    callback launch-options();
    // Change cover (0) or Change backdrop (1): opens the art picker.
    callback change-art(int);
    callback show-steam-app();
    callback more-achievements();
    callback retry();
    callback steam-app-save(string);
    callback steam-app-clear();
    // 0 Wine settings, 1 winetricks, 2 GOG's setup, 3 the known fixes.
    callback prefix-run(int);
    callback prefix-pick();
    callback prefix-typed(string);
    callback prefix-install();
    callback more-changelog();
}

component Card inherits Rectangle {
    in property <string> heading;
    // A small button on the heading row, for a card that opens and closes
    // (`+` and `−`); empty is no button. The heading itself opens and closes
    // it too, when there is one.
    in property <string> action-label;
    callback action-clicked;
    background: Colors.surface;
    border-width: 1px;
    border-color: Colors.line;
    VerticalLayout {
        padding: Space.l;
        spacing: Space.m;
        Rectangle {
            height: heading-row.preferred-height;
            heading-touch := TouchArea {
                mouse-cursor: root.action-label != "" ? pointer : default;
                clicked => { root.action-clicked(); }
            }
            heading-row := HorizontalLayout {
                spacing: Space.m;
                Text {
                    horizontal-stretch: 1;
                    text: root.heading.to-uppercase();
                    font-size: 14px;
                    font-weight: 700;
                    color: Colors.foreground;
                    vertical-alignment: center;
                }
                if root.action-label != "": ActionButton {
                    label: root.action-label;
                    small: true;
                    horizontal-stretch: 0;
                    clicked => { root.action-clicked(); }
                }
            }
        }
        @children
    }
}

component FactRow inherits HorizontalLayout {
    in property <Fact> fact;
    spacing: Space.s;
    Text {
        width: 130px;
        text: root.fact.label;
        wrap: word-wrap;
        color: Colors.dim;
        vertical-alignment: top;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Space.s;
        if root.fact.url == "": Text {
            text: root.fact.value;
            font-size: root.fact.mono ? 12px : 14px;
            color: root.fact.tone == 1 ? Colors.good : root.fact.tone == 2 ? Colors.bad : root.fact.tone == 3 ? Colors.dim : root.fact.tone == 4 ? Colors.accent : Colors.foreground;
            wrap: word-wrap;
        }
        if root.fact.url != "": Rectangle {
            height: link-text.preferred-height;
            link-text := Text {
                width: parent.width;
                text: root.fact.value;
                font-size: 14px;
                color: link-touch.has-hover ? Colors.accent : Colors.foreground;
            }
            link-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { GameData.open-path(root.fact.url); }
            }
        }
        if root.fact.path: ActionButton {
            label: Tr.t("files-open-folder");
            small: true;
            horizontal-stretch: 0;
            clicked => { GameData.open-path(root.fact.value); }
        }
    }
}

// Whether the game's anti-cheat lets it play online on Linux: the verdict, the
// anti-cheats it ships, what the site says, its notes and the way to its page.
component AntiCheatCard inherits Card {
    heading: Tr.t("anti-cheat-title");
    property <color> tone: GameData.ac-tone == 1 ? Colors.good : GameData.ac-tone == 2 ? Colors.bad : Colors.dim;
    VerticalLayout {
        spacing: Space.m;
        HorizontalLayout {
            alignment: start;
            spacing: Space.m;
            Rectangle {
                width: verdict.preferred-width + 14px;
                height: verdict.preferred-height + 4px;
                border-width: 1px;
                border-color: root.tone.with-alpha(0.5);
                verdict := Text {
                    x: 7px;
                    y: 2px;
                    text: GameData.ac-label;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.tone;
                }
            }
            Text {
                text: GameData.ac-makers;
                font-size: 14px;
                color: Colors.dim;
                vertical-alignment: center;
            }
        }
        Text {
            text: GameData.ac-about;
            font-size: 14px;
            color: Colors.foreground;
            wrap: word-wrap;
        }
        for note in GameData.ac-notes: HorizontalLayout {
            spacing: Space.m;
            Text {
                text: "\u{2022}";
                font-size: 14px;
                color: Colors.dim;
                vertical-alignment: top;
            }
            Rectangle {
                horizontal-stretch: 1;
                height: note-text.preferred-height;
                note-text := Text {
                    width: parent.width;
                    text: note.label;
                    font-size: 14px;
                    wrap: word-wrap;
                    color: note-touch.has-hover && note.url != "" ? Colors.accent : Colors.foreground;
                }
                note-touch := TouchArea {
                    enabled: note.url != "";
                    mouse-cursor: note.url != "" ? pointer : default;
                    clicked => { GameData.open-path(note.url); }
                }
            }
        }
        ActionButton {
            label: Tr.t("anti-cheat-open");
            small: true;
            horizontal-stretch: 0;
            clicked => { GameData.open-path(GameData.ac-url); }
        }
    }
}

// The game's mods: the profile, each mod in order with its box and its
// buttons, a Bethesda game's plugins, the folder they go in, and Apply.
// Every control is dimmed while a change is in flight (`ModsData.free`).
component ModsCard inherits Card {
    heading: Tr.t("mods-title");
    // The room for a wrapped line: the card's, less its padding and the box.
    property <length> wide: root.width - 2 * Space.l - 28px;
    body := VerticalLayout {
        spacing: Space.m;
        HorizontalLayout {
            spacing: Space.s;
            alignment: end;
            if ModsData.nexus: ActionButton {
                label: Tr.t("mods-search-nexus");
                small: true;
                clicked => { ModsData.search-nexus(); }
            }
            if ModsData.nexus: ActionButton {
                label: Tr.t("mods-find-on-nexus");
                small: true;
                clicked => { ModsData.find-nexus(); }
            }
            ActionButton {
                label: Tr.t("mods-add");
                small: true;
                enabled: ModsData.free;
                clicked => { ModsData.add(); }
            }
        }
        for download in ModsData.downloads: DownloadLine {
            item: download;
            stop(id) => { ModsData.stop-download(id); }
        }
        if ModsData.body-kind != 2: Text {
            text: ModsData.message;
            font-size: 13px;
            color: ModsData.body-kind == 1 ? Colors.bad : Colors.dim;
            wrap: word-wrap;
        }
        if ModsData.body-kind == 2: VerticalLayout {
            spacing: Space.m;
            // The profile in use, to switch; or the name being typed.
            if !ModsData.naming: HorizontalLayout {
                spacing: Space.s;
                Text {
                    text: Tr.t("mods-profile");
                    font-size: 14px;
                    color: Colors.dim;
                    vertical-alignment: center;
                    width: 90px;
                }
                FlexboxLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                    cross-axis-alignment: start;
                    cross-axis-line-alignment: start;
                    spacing: Space.s;
                    for chip in ModsData.profiles: ChipButton {
                        label: chip.label;
                        chosen: chip.chosen;
                        clicked => { if ModsData.free { ModsData.profile(chip.id); } }
                    }
                }
                RowButton {
                    label: Tr.t("mods-profile-new");
                    enabled: ModsData.free;
                    clicked => { ModsData.new-profile(); }
                }
                RowButton {
                    label: Tr.t("mods-profile-rename-button");
                    enabled: ModsData.free;
                    clicked => { ModsData.rename-profile(); }
                }
                RowButton {
                    label: ModsData.delete-profile-label;
                    danger: ModsData.delete-profile-asking;
                    enabled: ModsData.delete-profile-on;
                    clicked => { ModsData.delete-profile(); }
                }
            }
            if ModsData.naming: HorizontalLayout {
                spacing: Space.s;
                Text {
                    text: Tr.t("mods-profile");
                    font-size: 14px;
                    color: Colors.dim;
                    vertical-alignment: center;
                    width: 90px;
                }
                name-field := TextField {
                    horizontal-stretch: 1;
                    placeholder: ModsData.name-placeholder;
                    text <=> ModsData.name;
                    edited(typed) => { ModsData.name-typed(typed); }
                    accepted => { ModsData.save-name(); }
                    init => { self.focus-field(); }
                }
                RowButton {
                    label: Tr.t("key-save");
                    enabled: ModsData.name-ok;
                    clicked => { ModsData.save-name(); }
                }
                RowButton {
                    label: Tr.t("cancel");
                    clicked => { ModsData.cancel-name(); }
                }
            }
            Text {
                text: ModsData.place;
                font-size: 13px;
                color: Colors.dim;
                wrap: word-wrap;
            }
            Text {
                text: ModsData.target;
                font-size: 13px;
                color: Colors.foreground;
                wrap: word-wrap;
            }
            if ModsData.mods.length == 0: Text {
                text: Tr.t("mods-none");
                font-size: 14px;
                color: Colors.dim;
            }
            // One flat row per mod: its box, its name and buttons, then its
            // facts under the name.
            for line[index] in ModsData.mods: VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: Space.s;
                    CheckBox {
                        on: line.enabled;
                        label: line.name;
                        toggled(on) => { if ModsData.free { ModsData.toggle(index, on); } }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: line.name;
                        font-size: 14px;
                        color: Colors.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    RowButton {
                        label: line.update;
                        primary: true;
                        clicked => { ModsData.update(index); }
                    }
                    RowButton {
                        label: line.options;
                        enabled: ModsData.free;
                        clicked => { ModsData.options(index); }
                    }
                    RowButton {
                        label: "↑";
                        enabled: ModsData.free && line.up;
                        clicked => { ModsData.step(index, true); }
                    }
                    RowButton {
                        label: "↓";
                        enabled: ModsData.free && line.down;
                        clicked => { ModsData.step(index, false); }
                    }
                    RowButton {
                        label: line.delete-label;
                        danger: line.asking;
                        enabled: ModsData.free;
                        clicked => { ModsData.remove(index); }
                    }
                }
                HorizontalLayout {
                    Rectangle { width: 28px; }
                    Text {
                        width: root.wide;
                        text: line.facts;
                        font-size: 12px;
                        color: Colors.dim;
                        wrap: word-wrap;
                    }
                }
            }
            if ModsData.plugins-show: VerticalLayout {
                spacing: Space.s;
                Text {
                    text: Tr.t("plugins-title").to-uppercase();
                    font-size: 13px;
                    font-weight: 700;
                    color: Colors.foreground;
                }
                Text {
                    text: ModsData.plugins-note;
                    font-size: 13px;
                    color: ModsData.plugins-note-bad ? Colors.bad : Colors.dim;
                    wrap: word-wrap;
                }
                Text {
                    text: ModsData.plugins-file;
                    font-size: 12px;
                    color: Colors.dim;
                    wrap: word-wrap;
                    max-height: ModsData.plugins-file == "" ? 0px : 1000px;
                }
                if ModsData.plugins.length == 0: Text {
                    text: Tr.t("plugins-none");
                    font-size: 13px;
                    color: Colors.dim;
                }
                for plugin[index] in ModsData.plugins: VerticalLayout {
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: Space.s;
                        CheckBox {
                            on: plugin.enabled;
                            label: plugin.name;
                            opacity: plugin.locked ? 0.5 : 1.0;
                            toggled(on) => {
                                if ModsData.free && !plugin.locked { ModsData.plugin-toggle(index, on); }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: plugin.name;
                            font-size: 14px;
                            color: Colors.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        RowButton {
                            label: "↑";
                            enabled: ModsData.free && plugin.up;
                            clicked => { ModsData.plugin-step(index, true); }
                        }
                        RowButton {
                            label: "↓";
                            enabled: ModsData.free && plugin.down;
                            clicked => { ModsData.plugin-step(index, false); }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { width: 28px; }
                        Text {
                            width: root.wide;
                            text: plugin.facts;
                            font-size: 12px;
                            color: Colors.dim;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        max-height: plugin.problems == "" ? 0px : 1000px;
                        Rectangle { width: 28px; }
                        Text {
                            width: root.wide;
                            text: plugin.problems;
                            font-size: 12px;
                            color: Colors.bad;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if ModsData.overwrite != "": HorizontalLayout {
                spacing: Space.m;
                Text {
                    horizontal-stretch: 1;
                    text: ModsData.overwrite;
                    font-size: 13px;
                    color: Colors.dim;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                RowButton {
                    label: ModsData.overwrite-label;
                    danger: ModsData.overwrite-asking;
                    enabled: ModsData.free;
                    clicked => { ModsData.clear-overwrite(); }
                }
            }
            HorizontalLayout {
                spacing: Space.s;
                Text {
                    text: Tr.t("mods-folder");
                    font-size: 14px;
                    color: Colors.dim;
                    vertical-alignment: center;
                    width: 90px;
                }
                TextField {
                    horizontal-stretch: 1;
                    placeholder: Tr.t("mods-folder-placeholder");
                    text <=> ModsData.folder;
                    read-only: !ModsData.folder-editable;
                    edited(typed) => { ModsData.folder-typed(typed); }
                    accepted => { ModsData.save-folder(); }
                }
                RowButton {
                    label: ModsData.folder-save ? Tr.t("key-save") : "";
                    enabled: ModsData.free;
                    clicked => { ModsData.save-folder(); }
                }
                RowButton {
                    label: ModsData.folder-known ? Tr.t("mods-folder-known") : "";
                    enabled: ModsData.free;
                    clicked => { ModsData.known-folder(); }
                }
            }
            HorizontalLayout {
                spacing: Space.s;
                Text {
                    horizontal-stretch: 1;
                    text: ModsData.state;
                    font-size: 13px;
                    color: ModsData.state-tone == 1 ? Colors.good : ModsData.state-tone == 2 ? Colors.bad : Colors.dim;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                ActionButton {
                    label: Tr.t("mods-back-to-vanilla");
                    enabled: ModsData.can-restore;
                    clicked => { ModsData.restore(); }
                }
                ActionButton {
                    label: Tr.t("mods-apply");
                    primary: true;
                    enabled: ModsData.can-apply;
                    clicked => { ModsData.apply(); }
                }
            }
        }
        // Always as tall as a line, so it coming and going moves nothing.
        Text {
            height: 18px;
            text: ModsData.busy;
            font-size: 13px;
            color: Colors.dim;
        }
    }
}

// The tools that act on the game's Wine prefix, a box to install components
// and the game's known fixes, with how the last tool went.
component PrefixCard inherits Card {
    heading: Tr.t("prefix-title");
    VerticalLayout {
        spacing: Space.m;
        Text {
            text: Tr.t("prefix-about");
            font-size: 13px;
            color: Colors.dim;
            wrap: word-wrap;
        }
        FlexboxLayout {
            vertical-stretch: 0;
            cross-axis-alignment: start;
            cross-axis-line-alignment: start;
            spacing: Space.s;
            ActionButton {
                label: Tr.t("prefix-wine-settings");
                small: true;
                enabled: GameData.prefix-free;
                clicked => { GameData.prefix-run(0); }
            }
            ActionButton {
                label: "winetricks";
                small: true;
                enabled: GameData.prefix-free;
                clicked => { GameData.prefix-run(1); }
            }
            ActionButton {
                label: Tr.t("prefix-run-program");
                small: true;
                enabled: GameData.prefix-free;
                clicked => { GameData.prefix-pick(); }
            }
            if GameData.prefix-gog: ActionButton {
                label: Tr.t("prefix-gog-setup");
                small: true;
                enabled: GameData.prefix-free;
                clicked => { GameData.prefix-run(2); }
            }
            if GameData.prefix-folder != "": ActionButton {
                label: Tr.t("files-open-folder");
                small: true;
                clicked => { GameData.open-path(GameData.prefix-folder); }
            }
        }
        HorizontalLayout {
            spacing: Space.m;
            TextField {
                horizontal-stretch: 1;
                placeholder: Tr.t("prefix-components-placeholder");
                text <=> GameData.prefix-components;
                edited(typed) => { GameData.prefix-typed(typed); }
                accepted => {
                    if GameData.prefix-free { GameData.prefix-install(); }
                }
            }
            ActionButton {
                label: Tr.t("prefix-install");
                small: true;
                enabled: GameData.prefix-free;
                horizontal-stretch: 0;
                clicked => { GameData.prefix-install(); }
            }
        }
        if GameData.prefix-fixes.length > 0: HorizontalLayout {
            spacing: Space.m;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Space.xs;
                Text {
                    text: Tr.t("prefix-known-fixes-title");
                    font-size: 14px;
                    color: Colors.foreground;
                }
                for fix in GameData.prefix-fixes: Text {
                    text: fix.label;
                    font-size: 13px;
                    color: Colors.dim;
                    wrap: word-wrap;
                }
            }
            ActionButton {
                label: Tr.t("prefix-known-fixes");
                small: true;
                enabled: GameData.prefix-free;
                horizontal-stretch: 0;
                clicked => { GameData.prefix-run(3); }
            }
        }
        if GameData.prefix-status != "": Text {
            text: GameData.prefix-status;
            font-size: 13px;
            wrap: word-wrap;
            color: GameData.prefix-status-tone == 1 ? Colors.good : GameData.prefix-status-tone == 2 ? Colors.bad : Colors.dim;
        }
    }
}

// A badge that opens a page, with its words on hover, below it.
component PillButton inherits Rectangle {
    in property <Pill> pill;
    property <color> tone: root.pill.tone == 1 ? Colors.good : root.pill.tone == 2 ? Colors.bad : root.pill.tone == 3 ? Colors.dim : root.pill.tint;
    width: pill-text.preferred-width + 14px;
    height: pill-text.preferred-height + 4px;
    background: touch.has-hover ? root.tone.with-alpha(0.25) : Colors.background.with-alpha(0.82);
    border-width: 1px;
    border-color: root.tone.with-alpha(0.5);
    accessible-role: button;
    accessible-label: root.pill.label;
    accessible-action-default => { GameData.open-path(root.pill.url); }
    pill-text := Text {
        x: 7px;
        y: 2px;
        text: root.pill.label;
        font-size: 11px;
        font-weight: 700;
        color: root.tone;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { GameData.open-path(root.pill.url); }
    }
    if touch.has-hover && root.pill.tip != "": Rectangle {
        y: root.height + Space.xs;
        width: tip-text.preferred-width + 2 * Space.s;
        height: tip-text.preferred-height + 2 * Space.xs;
        background: Colors.surface;
        border-width: 1px;
        border-color: Colors.line;
        tip-text := Text {
            x: Space.s;
            y: Space.xs;
            text: root.pill.tip;
            font-size: 12px;
            color: Colors.foreground;
        }
    }
}

export component GamePage inherits Rectangle {
    // The room for the page's content: its width less the margins and the
    // scroll bar.
    property <length> inner: root.width - 2 * Space.xl - 14px;
    // Whether the page's wide column has anything to say.
    property <bool> has-main: GameData.about != "" || GameData.no-match != "" || GameData.shots.length > 0
        || GameData.dlc.length > 0 || GameData.sessions.length > 0 || GameData.ach.length > 0
        || GameData.req.length > 0 || GameData.failures.length > 0 || GameData.ac-show
        || ModsData.show || GameData.prefix-show || GameData.changelog.length > 0;
    property <int> scroll-request: GameData.scroll-end;
    changed scroll-request => {
        sv.content-y = min(0px, -(sv.content-height - sv.visible-height));
    }
    sv := ScrollView {
        // The content grew or shrank (a card arrived): keep the scroll inside
        // it, so the bottom stays reachable and no empty space is left over.
        changed content-height => {
            self.content-y = clamp(self.content-y, min(0px, -(self.content-height - self.visible-height)), 0px);
        }
        width: parent.width;
        height: parent.height;
        VerticalLayout {
            // An explicit width: a wrapped text's height is measured at it,
            // and the scroll's content height stays right (item 55c).
            width: parent.width - 14px;
            x: 0px;
            page := VerticalLayout {
                padding: Space.xl;
                spacing: Space.xl;
                // The back link, then the header over the faint wide art.
                HorizontalLayout {
                    alignment: start;
                    spacing: Space.s;
                    back := Rectangle {
                        width: back-text.preferred-width;
                        height: back-text.preferred-height;
                        back-text := Text {
                            text: (GameData.owned ? Tr.t("store-back") : Tr.t("game-back")).to-uppercase();
                            font-size: 13px;
                            color: back-touch.has-hover ? Colors.accent : Colors.dim;
                        }
                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { GameData.back(); }
                        }
                    }
                    if GameData.owned: Text {
                        text: "/";
                        font-size: 13px;
                        color: Colors.dim;
                    }
                    if GameData.owned: Text {
                        text: GameData.title.to-uppercase();
                        font-size: 13px;
                        color: Colors.dim;
                        overflow: elide;
                    }
                }
                header := Rectangle {
                    // Above what follows, so a pill's words draw over it.
                    z: 1;
                    height: 400px;
                    clip: true;
                    if GameData.has-backdrop: Image {
                        width: 100%;
                        height: 100%;
                        source: GameData.backdrop;
                        image-fit: cover;
                        opacity: 0.22;
                    }
                    HorizontalLayout {
                        padding: Space.l;
                        spacing: Space.xl;
                        VerticalLayout {
                            width: 200px;
                            alignment: start;
                            spacing: Space.s;
                        Rectangle {
                            width: 200px;
                            height: 300px;
                            clip: true;
                            background: Colors.surface;
                            if GameData.has-cover: Image {
                                width: 100%;
                                height: 100%;
                                source: GameData.cover;
                                image-fit: cover;
                            }
                            if !GameData.has-cover: Text {
                                x: Space.m;
                                width: parent.width - 2 * Space.m;
                                height: parent.height;
                                text: GameData.title;
                                font-size: 20px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: Colors.foreground;
                            }
                        }
                            ActionButton {
                                label: Tr.t("game-change-cover");
                                small: true;
                                width: 200px;
                                clicked => { GameData.change-art(0); }
                            }
                            ActionButton {
                                label: Tr.t("game-change-backdrop");
                                small: true;
                                width: 200px;
                                clicked => { GameData.change-art(1); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: start;
                            spacing: Space.s;
                            Text {
                                text: GameData.title;
                                font-size: 34px;
                                font-weight: 700;
                                color: Colors.foreground;
                                wrap: word-wrap;
                            }
                            Text {
                                text: GameData.source-line.to-uppercase();
                                font-size: 13px;
                                color: Colors.dim;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: Space.s;
                                padding-top: Space.s;
                                for badge in GameData.owned-badges: ActionButton {
                                    label: badge.label;
                                    small: true;
                                    tint: badge.good ? Colors.good : Colors.dim;
                                }
                                if GameData.update-badge != "": ActionButton {
                                    label: GameData.update-badge;
                                    small: true;
                                    tint: Colors.accent;
                                }
                                if GameData.pinned: ActionButton {
                                    label: GameData.favorite-badge;
                                    small: true;
                                    tint: Colors.accent;
                                }
                                if GameData.hidden: ActionButton {
                                    label: GameData.hidden-badge;
                                    small: true;
                                }
                                if !GameData.owned: ActionButton {
                                    label: "PCGamingWiki";
                                    small: true;
                                    clicked => { GameData.wiki(); }
                                }
                                for pill in GameData.pills: PillButton { pill: pill; }
                            }
                        }
                    }
                }
                // A store game: Open in library when it is there, else what
                // installing it would do.
                if GameData.owned: VerticalLayout {
                    spacing: Space.m;
                    HorizontalLayout {
                        spacing: Space.m;
                        if GameData.owned-installed: ActionButton {
                            label: Tr.t("store-open-in-library");
                            primary: true;
                            clicked => { GameData.open-library(); }
                        }
                        // Install and Import, until the game is queued.
                        if GameData.owned-job == 1: ActionButton {
                            label: Tr.t("install");
                            primary: true;
                            clicked => { GameData.owned-install(); }
                        }
                        if GameData.owned-job == 1: ActionButton {
                            label: Tr.t("downloads-import");
                            clicked => { GameData.owned-import(); }
                        }
                        // Queued, running (nothing to press) or paused.
                        if GameData.owned-job == 2: ActionButton {
                            label: Tr.t("queued");
                            primary: true;
                            enabled: false;
                        }
                        if GameData.owned-job == 3: ActionButton {
                            label: GameData.owned-job-label;
                            primary: true;
                            enabled: false;
                        }
                        if GameData.owned-job == 4: ActionButton {
                            label: Tr.t("resume");
                            primary: true;
                            clicked => { GameData.owned-resume(); }
                        }
                        // A Steam game: Steam's own dialog does the install.
                        // Steam writes nothing when it is cancelled, so the
                        // button asks again, and Stop waiting ends the wait.
                        if GameData.owned-job >= 5: ActionButton {
                            label: GameData.owned-job-label;
                            primary: true;
                            enabled: GameData.owned-job != 7;
                            clicked => { GameData.owned-install(); }
                        }
                        if GameData.owned-job == 6: ActionButton {
                            label: Tr.t("steam-stop-waiting");
                            clicked => { GameData.owned-forget(); }
                        }
                        if GameData.owned-job >= 2 && GameData.owned-job != 5: ActionButton {
                            label: Tr.t("see-downloads");
                            clicked => { GameData.owned-downloads(); }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: GameData.owned-note;
                            font-size: 14px;
                            color: Colors.dim;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if GameData.owned-progress >= 0: Rectangle {
                        height: 8px;
                        background: Colors.raised;
                        Rectangle {
                            x: 0px;
                            width: parent.width * Math.min(GameData.owned-progress, 100) / 100;
                            background: Colors.accent;
                        }
                    }
                    if GameData.owned-dlc != "": HorizontalLayout {
                        spacing: Space.m;
                        alignment: start;
                        CheckBox {
                            on: GameData.owned-dlc-on;
                            label: GameData.owned-dlc;
                            toggled(on) => { GameData.owned-toggle-dlc(); }
                        }
                        // The words toggle it too, as Iced's label does.
                        Rectangle {
                            width: dlc-words.preferred-width;
                            height: 20px;
                            dlc-words := Text {
                                height: parent.height;
                                text: GameData.owned-dlc;
                                font-size: 14px;
                                color: Colors.foreground;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { GameData.owned-toggle-dlc(); }
                            }
                        }
                    }
                }
                // Play, or Running with Stop; then the less pressed ones.
                if !GameData.owned: VerticalLayout {
                    spacing: Space.s;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Space.m;
                        ActionButton {
                            label: GameData.run-state == 0 ? Tr.t("run-play")
                                : GameData.run-state == 1 ? Tr.t("run-state-starting")
                                : Tr.t("run-state-running");
                            primary: true;
                            enabled: GameData.run-state == 0;
                            clicked => { GameData.play(); }
                        }
                        if GameData.run-state >= 2: ActionButton {
                            label: GameData.run-state == 3 ? Tr.t("run-force-stop") : Tr.t("run-stop");
                            danger: true;
                            clicked => { GameData.stop(); }
                        }
                        if GameData.update-label != "": ActionButton {
                            label: GameData.update-label;
                            enabled: GameData.update-on;
                            clicked => { GameData.update(); }
                        }
                        if GameData.launch-options-shown: ActionButton {
                            label: Tr.t("game-launch-options");
                            clicked => { GameData.launch-options(); }
                        }
                        ActionButton {
                            label: GameData.pinned ? Tr.t("game-unfavorite") : Tr.t("game-favorite");
                            clicked => { GameData.toggle-pinned(); }
                        }
                        ActionButton {
                            label: GameData.hidden ? Tr.t("game-unhide") : Tr.t("game-hide");
                            clicked => { GameData.toggle-hidden(); }
                        }
                        if GameData.local: ActionButton {
                            label: Tr.t("edit");
                            clicked => { GameData.edit(); }
                        }
                        if GameData.local: ActionButton {
                            label: GameData.confirm-remove ? Tr.t("really-remove") : Tr.t("remove");
                            danger: GameData.confirm-remove;
                            clicked => { GameData.remove(); }
                        }
                        if GameData.steam: ActionButton {
                            label: Tr.t("game-manage-steam");
                            clicked => { GameData.manage-steam(); }
                        }
                        if GameData.has-more: ActionButton {
                            label: GameData.more-open ? Tr.t("game-less") : Tr.t("game-more");
                            clicked => { GameData.toggle-more(); }
                        }
                    }
                    // The job queued for the game, or the last thing said.
                    HorizontalLayout {
                        alignment: start;
                        spacing: Space.m;
                        Text {
                            text: GameData.line;
                            font-size: 14px;
                            color: Colors.dim;
                            vertical-alignment: center;
                        }
                        if GameData.job-shown: ActionButton {
                            label: Tr.t("see-downloads");
                            small: true;
                            clicked => { GameData.see-downloads(); }
                        }
                    }
                    // The less used actions: a game Zendo installed can be
                    // checked, repaired, moved and uninstalled; a Steam game
                    // verified and uninstalled, both asked of Steam.
                    if GameData.has-more && GameData.more-open: Rectangle {
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.line;
                        height: more-row.preferred-height;
                        more-row := HorizontalLayout {
                            padding-left: Space.l;
                            padding-right: Space.l;
                            padding-top: Space.m;
                            padding-bottom: Space.m;
                            spacing: Space.m;
                            alignment: start;
                            if GameData.managed: ActionButton {
                                label: Tr.t("downloads-check-updates");
                                enabled: GameData.check-on;
                                clicked => { GameData.check-updates(); }
                            }
                            if GameData.managed: ActionButton {
                                label: Tr.with("action-label", "action", "repair");
                                enabled: GameData.job-free;
                                clicked => { GameData.repair(); }
                            }
                            if GameData.managed: ActionButton {
                                label: Tr.t("downloads-move");
                                enabled: GameData.move-on;
                                clicked => { GameData.move-game(); }
                            }
                            if GameData.managed: ActionButton {
                                label: GameData.uninstall-again ? Tr.t("downloads-press-again") : Tr.with("action-label", "action", "uninstall");
                                danger: GameData.uninstall-again;
                                enabled: GameData.job-free;
                                clicked => { GameData.uninstall(); }
                            }
                            if GameData.steam-verify-label != "": ActionButton {
                                label: GameData.steam-verify-label;
                                enabled: GameData.steam-verify-on;
                                clicked => { GameData.steam-verify(); }
                            }
                            if GameData.steam-uninstall-label != "": ActionButton {
                                label: GameData.steam-uninstall-label;
                                clicked => { GameData.steam-uninstall(); }
                            }
                        }
                    }
                }
                // The collections the game is in, and the way to change them.
                if !GameData.owned: HorizontalLayout {
                    alignment: start;
                    spacing: Space.s;
                    Text {
                        text: Tr.t("library-organize").to-uppercase();
                        font-size: 12px;
                        color: Colors.dim;
                        vertical-alignment: center;
                    }
                    if GameData.collections.length == 0: Text {
                        text: Tr.t("collections-none");
                        font-size: 13px;
                        color: Colors.dim;
                        vertical-alignment: center;
                    }
                    for name in GameData.collections: Rectangle {
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.line;
                        HorizontalLayout {
                            padding-left: Space.s;
                            padding-right: Space.s;
                            padding-top: 2px;
                            padding-bottom: 2px;
                            Text {
                                text: name.to-uppercase();
                                font-size: 11px;
                                font-weight: 700;
                                color: Colors.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                    ActionButton {
                        label: Tr.t("game-edit-categories");
                        small: true;
                        clicked => { GameData.edit-collections(); }
                    }
                }
                // The play status: the chosen one is pressed again to clear it.
                if !GameData.owned: HorizontalLayout {
                    alignment: start;
                    spacing: Space.s;
                    Text {
                        text: Tr.t("game-status").to-uppercase();
                        font-size: 12px;
                        color: Colors.dim;
                        vertical-alignment: center;
                    }
                    for chip in GameData.statuses: ChipButton {
                        label: chip.label;
                        chosen: chip.chosen;
                        clicked => { GameData.status(chip.id); }
                    }
                }
                // (A store game has none, or one, a quarter of the width.)
                if GameData.tiles.length > 0: HorizontalLayout {
                    spacing: Space.m;
                    width: GameData.owned ? root.inner * 0.25 : root.inner;
                    for tile in GameData.tiles: Rectangle {
                        horizontal-stretch: 1;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.line;
                        VerticalLayout {
                            padding: Space.l;
                            spacing: Space.s;
                            Text {
                                text: tile.label.to-uppercase();
                                font-size: 12px;
                                color: Colors.dim;
                            }
                            Text {
                                text: tile.value;
                                font-size: 22px;
                                font-weight: 700;
                                color: Colors.foreground;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Space.xl;
                    if root.has-main: VerticalLayout {
                        width: (root.inner - Space.xl) * 0.6;
                        alignment: start;
                        spacing: Space.xl;
                        if GameData.ac-show && GameData.ac-first: AntiCheatCard { }
                        if GameData.about != "": Card {
                            heading: Tr.t("game-about");
                            Text {
                                text: GameData.about;
                                font-size: 14px;
                                color: Colors.foreground;
                                wrap: word-wrap;
                            }
                        }
                        if GameData.no-match != "": Card {
                            heading: Tr.t("game-about");
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: GameData.no-match;
                                    font-size: 13px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Tr.t("steam-app-set");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.show-steam-app(); }
                                }
                            }
                        }
                        if GameData.shots.length > 0: Card {
                            heading: Tr.t("screenshots-title");
                            Flickable {
                                height: 150px;
                                content-width: shots-row.preferred-width;
                                shots-row := HorizontalLayout {
                                    spacing: Space.m;
                                    for shot in GameData.shots: Rectangle {
                                        width: shot.ready ? self.height * shot.thumb.width / max(1, shot.thumb.height) : 267px;
                                        height: 150px;
                                        background: Colors.raised;
                                        if shot.ready: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: shot.thumb;
                                            image-fit: cover;
                                        }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { GameData.open-path(shot.full); }
                                        }
                                    }
                                }
                            }
                        }
                        if GameData.ac-show && !GameData.ac-first: AntiCheatCard { }
                        if GameData.dlc.length > 0: Card {
                            heading: Tr.t("dlc-title");
                            VerticalLayout {
                                spacing: Space.m;
                                HorizontalLayout {
                                    spacing: Space.m;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: GameData.dlc-count;
                                        font-size: 13px;
                                        color: Colors.dim;
                                        vertical-alignment: center;
                                    }
                                    RowButton {
                                        label: GameData.dlc-install-all;
                                        enabled: GameData.dlc-install-all-on;
                                        clicked => { GameData.dlc-all(); }
                                    }
                                }
                                // One flat row per DLC: its words, then its
                                // button or what it is instead of one.
                                for line in GameData.dlc: HorizontalLayout {
                                    spacing: Space.m;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text {
                                            text: line.title;
                                            font-size: 14px;
                                            color: Colors.foreground;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            height: line.about == "" ? 0px : 16px;
                                            text: line.about;
                                            font-size: 12px;
                                            color: Colors.dim;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: line.status;
                                        font-size: 13px;
                                        color: line.status-tone == 1 ? Colors.good : Colors.dim;
                                        vertical-alignment: center;
                                    }
                                    RowButton {
                                        label: line.label;
                                        danger: line.danger;
                                        enabled: line.enabled;
                                        clicked => { GameData.dlc-action(line.id); }
                                    }
                                }
                                if GameData.dlc-note != "": Text {
                                    text: GameData.dlc-note;
                                    font-size: 12px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        if ModsData.show: ModsCard { }
                        if GameData.prefix-show: PrefixCard { }
                        if GameData.changelog.length > 0: Card {
                            heading: Tr.t("changelog-title");
                            VerticalLayout {
                                spacing: Space.s;
                                // One text per line: an update's title and headings in bold,
                                // paragraphs, items with a bullet, a thin gap between updates.
                                for part in GameData.changelog: Text {
                                    text: part.kind == 3 ? "\u{2022}  " + part.text : part.kind == 4 ? " " : part.text;
                                    font-size: part.kind == 0 ? 15px : part.kind == 4 ? 10px : 14px;
                                    font-weight: part.kind <= 1 ? 700 : 400;
                                    color: part.kind == 1 ? Colors.dim : Colors.foreground;
                                    wrap: word-wrap;
                                }
                                if GameData.changelog-more != "": ActionButton {
                                    label: GameData.changelog-more;
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.more-changelog(); }
                                }
                            }
                        }
                        if GameData.sessions.length > 0: Card {
                            heading: Tr.t("stats-game-title");
                            VerticalLayout {
                                spacing: Space.l;
                                HorizontalLayout {
                                    spacing: Space.xl;
                                    for fact in GameData.sessions: VerticalLayout {
                                        spacing: Space.xs;
                                        Text {
                                            text: fact.label.to-uppercase();
                                            font-size: 12px;
                                            color: Colors.dim;
                                        }
                                        Text {
                                            text: fact.value;
                                            font-size: 18px;
                                            font-weight: 700;
                                            color: Colors.foreground;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: Space.xs;
                                    for fact in GameData.recent: HorizontalLayout {
                                        spacing: Space.l;
                                        Text {
                                            width: 110px;
                                            text: fact.label;
                                            font-size: 13px;
                                            color: Colors.dim;
                                        }
                                        Text {
                                            text: fact.value;
                                            font-size: 13px;
                                            color: Colors.foreground;
                                        }
                                    }
                                }
                            }
                        }
                        if GameData.ach.length > 0: Card {
                            heading: Tr.t("achievements-title");
                            VerticalLayout {
                                spacing: Space.m;
                                HorizontalLayout {
                                    spacing: Space.m;
                                    Text {
                                        text: GameData.ach-summary;
                                        font-size: 14px;
                                        color: GameData.ach-share >= 0 ? Colors.foreground : Colors.dim;
                                        wrap: word-wrap;
                                        horizontal-stretch: GameData.ach-share >= 0 ? 0 : 1;
                                    }
                                    if GameData.ach-share >= 0: Rectangle {
                                        horizontal-stretch: 1;
                                        height: 6px;
                                        y: 8px;
                                        background: Colors.raised;
                                        Rectangle {
                                            x: 0;
                                            width: parent.width * clamp(GameData.ach-share, 0, 1);
                                            background: Colors.accent;
                                        }
                                    }
                                }
                                for a in GameData.ach: HorizontalLayout {
                                    spacing: Space.m;
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        background: Colors.raised;
                                        clip: true;
                                        if a.has-icon: Image {
                                            width: 100%;
                                            height: 100%;
                                            source: a.icon;
                                            image-fit: cover;
                                        }
                                        if !a.has-icon: Text {
                                            text: "?";
                                            color: Colors.dim;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: Space.xs;
                                        Text {
                                            text: a.name;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: Colors.foreground;
                                            wrap: word-wrap;
                                        }
                                        if a.description != "": Text {
                                            text: a.description;
                                            font-size: 13px;
                                            color: Colors.dim;
                                            wrap: word-wrap;
                                        }
                                    }
                                    Text {
                                        text: a.side;
                                        font-size: 13px;
                                        color: a.unlocked ? Colors.good : Colors.dim;
                                        vertical-alignment: center;
                                    }
                                }
                                if GameData.ach-more != "": ActionButton {
                                    label: GameData.ach-more;
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.more-achievements(); }
                                }
                            }
                        }
                        if GameData.req.length > 0: Card {
                            heading: Tr.t("requirements-title");
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: GameData.req-source;
                                    font-size: 13px;
                                    color: Colors.dim;
                                }
                                if GameData.req-both: HorizontalLayout {
                                    spacing: Space.s;
                                    Rectangle { width: 130px; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: Tr.t("requirements-minimum");
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Colors.dim;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: Tr.t("requirements-recommended");
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Colors.dim;
                                    }
                                }
                                for r in GameData.req: HorizontalLayout {
                                    spacing: Space.s;
                                    Text {
                                        width: 130px;
                                        text: r.label;
                                        font-size: 14px;
                                        color: Colors.dim;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: r.minimum;
                                        font-size: 14px;
                                        color: Colors.foreground;
                                        wrap: word-wrap;
                                    }
                                    if GameData.req-both: Text {
                                        horizontal-stretch: 1;
                                        text: r.recommended;
                                        font-size: 14px;
                                        color: Colors.foreground;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        // Cards that could not be asked, with the way to ask again.
                        for failed in GameData.failures: Card {
                            heading: failed.label;
                            VerticalLayout {
                                spacing: Space.m;
                                Text {
                                    text: failed.value;
                                    font-size: 13px;
                                    color: Colors.dim;
                                    wrap: word-wrap;
                                }
                                ActionButton {
                                    label: Tr.t("try-again");
                                    small: true;
                                    horizontal-stretch: 0;
                                    clicked => { GameData.retry(); }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        width: root.has-main ? (root.inner - Space.xl) * 0.4 : root.inner;
                        alignment: start;
                        spacing: Space.xl;
                        Card {
                            heading: Tr.t("game-details");
                            VerticalLayout {
                                spacing: Space.m;
                                for fact in GameData.details: FactRow { fact: fact; }
                            }
                        }
                        Card {
                            heading: Tr.t("game-technical");
                            action-label: GameData.technical-open ? "−" : "+";
                            action-clicked => { GameData.toggle-technical(); }
                            if GameData.technical-open: VerticalLayout {
                                spacing: Space.m;
                                for fact in GameData.technical: FactRow { fact: fact; }
                                if GameData.steam-app-row: HorizontalLayout {
                                    spacing: Space.s;
                                    Text {
                                        width: 130px;
                                        text: Tr.t("steam-app-label");
                                        wrap: word-wrap;
                                        color: Colors.dim;
                                        vertical-alignment: top;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: Space.s;
                                        Text {
                                            text: GameData.steam-app-line;
                                            font-size: 13px;
                                            font-weight: 700;
                                            color: Colors.foreground;
                                            wrap: word-wrap;
                                        }
                                        HorizontalLayout {
                                            spacing: Space.s;
                                            TextField {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                text <=> GameData.steam-app-input;
                                                placeholder: Tr.t("steam-app-placeholder");
                                                accepted => { GameData.steam-app-save(GameData.steam-app-input); }
                                            }
                                            ActionButton {
                                                label: Tr.t("steam-app-save");
                                                small: true;
                                                clicked => { GameData.steam-app-save(GameData.steam-app-input); }
                                            }
                                            if GameData.steam-app-clearable: ActionButton {
                                                label: Tr.t("steam-app-clear");
                                                small: true;
                                                clicked => { GameData.steam-app-clear(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
