// The art picker, over the window: a card with the cover / wide image tabs, a
// search for the title, the games found and the images to choose from. The
// Rust side (src/artwork_ui.rs) holds the picker and what each control does;
// nothing here keeps a choice.

import { Colors, Space, Tr } from "style.slint";
import { ActionButton, TextField, ChipButton } from "components.slint";
import { ChipData } from "library.slint";
import { ScrollView } from "std-widgets.slint";

// One image to choose: its thumbnail while `ready`, a box until then. `about`
// is its size, style and author, which shows in the footer under the pointer.
export struct ArtThumb {
    image: image,
    ready: bool,
    about: string,
}

export global ArtData {
    in-out property <bool> open;
    in property <string> title;
    // 0 covers, 1 wide images.
    in property <int> kind;
    in-out property <string> query;
    in property <[ChipData]> tabs;
    in property <[ChipData]> games;
    in property <[ArtThumb]> thumbs;
    in property <bool> more;
    in property <bool> busy;
    // What the picker is doing (dim) or what went wrong (red).
    in property <string> status;
    in property <string> note;
    in property <bool> needs-key;
    in property <string> automatic-label;
    // The size and author of the image under the pointer.
    in-out property <string> hover-about;

    callback chose-kind(int);
    callback edited(string);
    callback search();
    callback chose-game(int);
    callback choose(int);
    callback more-clicked();
    callback automatic();
    callback settings();
    callback close();
}

export component ArtSheet inherits Rectangle {
    background: #000000.with-alpha(0.6);
    // Nothing behind the sheet hears a click; one outside the card closes it.
    TouchArea {
        clicked => { ArtData.close(); }
    }

    private property <length> inner: card.width - 2 * Space.xl - 14px;
    private property <length> thumb-w: ArtData.kind == 0 ? 120px : 288px;
    private property <length> thumb-h: ArtData.kind == 0 ? 180px : 93px;

    card := Rectangle {
        width: min(980px, root.width - 2 * Space.xl);
        height: min(root.height - 2 * Space.xl, content.preferred-height);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Colors.background;
        border-width: 1px;
        border-color: Colors.line;
        // Clicks inside the card stay in it.
        TouchArea { }

        content := VerticalLayout {
            padding: Space.xl;
            spacing: Space.l;
            HorizontalLayout {
                spacing: Space.m;
                Text {
                    horizontal-stretch: 1;
                    text: Tr.with("art-title", "title", ArtData.title).to-uppercase();
                    font-size: 18px;
                    font-weight: 700;
                    color: Colors.foreground;
                    overflow: elide;
                    vertical-alignment: center;
                }
                for tab in ArtData.tabs: ChipButton {
                    label: tab.label;
                    chosen: tab.chosen;
                    clicked => { ArtData.chose-kind(tab.id); }
                }
            }
            HorizontalLayout {
                spacing: Space.m;
                search-field := TextField {
                    horizontal-stretch: 1;
                    text <=> ArtData.query;
                    placeholder: Tr.t("art-search-placeholder");
                    edited(text) => { ArtData.edited(text); }
                    accepted => { ArtData.search(); }
                }
                ActionButton {
                    label: Tr.t("art-search");
                    clicked => { ArtData.search(); }
                }
            }
            if ArtData.games.length > 0: FlexboxLayout {
                vertical-stretch: 0;
                cross-axis-alignment: start;
                cross-axis-line-alignment: start;
                spacing: Space.s;
                for game in ArtData.games: ChipButton {
                    label: game.label;
                    chosen: game.chosen;
                    clicked => { ArtData.chose-game(game.id); }
                }
            }
            // The images scroll; the footer stays where Close is.
            ScrollView {
                min-height: ArtData.thumbs.length > 0 ? 240px : 0px;
                preferred-height: ArtData.thumbs.length > 0 ? list.preferred-height : 0px;
                vertical-stretch: 1;
                list := VerticalLayout {
                    width: root.inner;
                    x: 0px;
                    spacing: Space.l;
                    FlexboxLayout {
                        vertical-stretch: 0;
                        cross-axis-alignment: start;
                        cross-axis-line-alignment: start;
                        spacing: Space.m;
                        for thumb[index] in ArtData.thumbs: Rectangle {
                            width: root.thumb-w;
                            height: root.thumb-h;
                            clip: true;
                            background: Colors.surface;
                            border-width: touch.has-hover && !ArtData.busy ? 2px : 0px;
                            border-color: Colors.accent;
                            Image {
                                width: 100%;
                                height: 100%;
                                source: thumb.image;
                                image-fit: cover;
                                opacity: thumb.ready ? 1.0 : 0.0;
                            }
                            touch := TouchArea {
                                mouse-cursor: ArtData.busy ? default : pointer;
                                changed has-hover => {
                                    if self.has-hover {
                                        ArtData.hover-about = thumb.about;
                                    } else if ArtData.hover-about == thumb.about {
                                        ArtData.hover-about = "";
                                    }
                                }
                                clicked => {
                                    if !ArtData.busy {
                                        ArtData.choose(index);
                                    }
                                }
                            }
                        }
                    }
                    if ArtData.more: HorizontalLayout {
                        alignment: start;
                        ActionButton {
                            label: Tr.t("art-show-more");
                            enabled: !ArtData.busy;
                            clicked => { ArtData.more-clicked(); }
                        }
                    }
                }
            }
            // What is under the pointer, then what the picker is doing or
            // what went wrong beside the buttons.
            // Its line is always there, so the buttons do not move when the
            // pointer comes and goes.
            Text {
                height: 16px;
                text: ArtData.hover-about;
                font-size: 12px;
                color: Colors.dim;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: Space.m;
                if ArtData.busy: Text {
                    horizontal-stretch: 1;
                    text: ArtData.status;
                    font-size: 13px;
                    color: Colors.dim;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if !ArtData.busy: Text {
                    horizontal-stretch: 1;
                    text: ArtData.note;
                    font-size: 13px;
                    color: Colors.bad;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
                if ArtData.needs-key: ActionButton {
                    label: Tr.t("art-open-settings");
                    clicked => { ArtData.settings(); }
                }
                if ArtData.automatic-label != "": ActionButton {
                    label: ArtData.automatic-label;
                    clicked => { ArtData.automatic(); }
                }
                ActionButton {
                    label: Tr.t("close");
                    clicked => { ArtData.close(); }
                }
            }
        }
    }

    // The field takes the keyboard when the sheet opens.
    init => { search-field.focus-field(); }
}
