// A mod's FOMOD installer: its steps one at a time, each group's options as
// radios or boxes, the option last touched described with its picture, then
// Install. Rust (src/installer_ui.rs) fills `InstallerData` from
// `zendo_shell::installer` and answers its callbacks; nothing here keeps state.
// The sheet does not close on a click outside it: closing drops the unpacked
// mod, so only Cancel and Escape do.

import { Colors, Space, Tr } from "style.slint";
import { ActionButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// One line of the list: a group's name (kind 0), a radio (1) or a box (2).
// `group` and `option` say which option a click on it is for.
export struct InstallerRow {
    kind: int,
    group: int,
    option: int,
    label: string,
    on: bool,
    enabled: bool,
    // Plain dim text: the mod says it cannot be used.
    dim: bool,
    // The option last touched, or under the cursor.
    focused: bool,
}

export global InstallerData {
    in property <bool> open;
    in property <string> title;
    in property <string> step-line;
    // The mod says it needs files that were not found.
    in property <bool> needs;
    in property <[InstallerRow]> rows;
    // The picture of the option described, when it has one and it is ready.
    in property <image> picture;
    in property <bool> has-picture;
    in property <string> about-name;
    in property <string> about-text;
    in property <bool> back-enabled;
    // "Install" on the last step, else "Next".
    in property <string> primary-label;

    // A row of `rows` was clicked.
    callback pick(int);
    // The language changed: the lines Rust built are asked for again.
    callback relabel();
    callback next();
    callback back();
    callback cancel();
}

// One line of the list. The rows are flat: the glyph and the text are chosen
// by the row's kind, with no `if` inside the repeater.
component OptionLine inherits Rectangle {
    in property <InstallerRow> item;
    callback clicked;

    height: root.item.kind == 0 ? 30px : 26px;
    background: root.item.focused ? Colors.raised : transparent;
    border-width: root.item.focused ? 1px : 0px;
    border-color: Colors.accent;

    // The radio's ring or the box.
    Rectangle {
        x: Space.s;
        y: (parent.height - self.height) / 2;
        width: root.item.kind == 0 ? 0px : 16px;
        height: 16px;
        border-radius: root.item.kind == 1 ? 8px : 0px;
        background: Colors.surface;
        border-width: root.item.kind == 0 ? 0px : 1px;
        border-color: root.item.on ? Colors.accent : Colors.line;
        opacity: root.item.enabled || root.item.on ? 1.0 : 0.5;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: root.item.kind == 1 ? 4px : 0px;
            background: root.item.on && root.item.kind != 0 ? Colors.accent : transparent;
        }
    }
    Text {
        x: root.item.kind == 0 ? 0px : Space.s + 16px + Space.s;
        y: 0px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.item.label;
        font-size: 14px;
        font-weight: root.item.kind == 0 ? 700 : 400;
        color: root.item.kind == 0 || (root.item.enabled && !root.item.dim) ? Colors.foreground : Colors.dim;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        enabled: root.item.kind != 0 && root.item.enabled;
        mouse-cursor: self.enabled ? pointer : default;
        // The role cannot depend on the row (Slint wants a constant), and a
        // list mixes radio rows and boxes: a checkbox that reports its
        // checked state is the honest common one.
        accessible-role: checkbox;
        accessible-label: root.item.label;
        accessible-checked: root.item.on;
        accessible-enabled: root.item.enabled;
        accessible-action-default => { if self.enabled { root.clicked(); } }
        clicked => { root.clicked(); }
    }
}

export component InstallerSheet inherits Rectangle {
    background: Colors.scrim;
    // Nothing behind the sheet hears a click, and none closes it.
    TouchArea { }

    card := Rectangle {
        width: min(920px, root.width - 2 * Space.xl);
        height: root.height - 2 * Space.xl;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Colors.background;
        border-width: 1px;
        border-color: Colors.line;
        // Clicks inside the card stay in it.
        TouchArea { }

        // The columns are explicit widths: stretch factors do not hold them.
        property <length> inner: card.width - 2 * Space.xl;
        property <length> list-width: (self.inner - Space.xl) * 0.6;
        property <length> about-width: self.inner - Space.xl - self.list-width;

        VerticalLayout {
            padding: Space.xl;
            spacing: Space.l;
            VerticalLayout {
                vertical-stretch: 0;
                spacing: Space.xs;
                Text {
                    text: InstallerData.title.to-uppercase();
                    font-size: 18px;
                    font-weight: 700;
                    color: Colors.foreground;
                    overflow: elide;
                }
                Text {
                    text: InstallerData.step-line;
                    font-size: 13px;
                    color: Colors.dim;
                    overflow: elide;
                }
                // Always takes its line, so the columns do not move.
                Text {
                    width: card.inner;
                    text: InstallerData.needs ? Tr.t("installer-needs") : "";
                    font-size: 13px;
                    color: Colors.bad;
                    wrap: word-wrap;
                    height: InstallerData.needs ? self.preferred-height : 0px;
                }
            }
            HorizontalLayout {
                spacing: Space.xl;
                vertical-stretch: 1;
                ScrollView {
                    width: card.list-width;
                    min-height: 120px;
                    preferred-height: list.preferred-height;
                    list := VerticalLayout {
                        x: 0px;
                        // Room at the right for the scrollbar.
                        width: card.list-width - 14px;
                        alignment: start;
                        spacing: 2px;
                        for line[index] in InstallerData.rows: OptionLine {
                            item: line;
                            clicked => { InstallerData.pick(index); }
                        }
                    }
                }
                ScrollView {
                    width: card.about-width;
                    min-height: 120px;
                    preferred-height: about.preferred-height;
                    about := VerticalLayout {
                        x: 0px;
                        width: card.about-width - 14px;
                        alignment: start;
                        spacing: Space.m;
                        Image {
                            source: InstallerData.picture;
                            image-fit: contain;
                            height: InstallerData.has-picture ? 220px : 0px;
                        }
                        Text {
                            width: card.about-width - 14px;
                            text: InstallerData.about-name;
                            font-size: 15px;
                            font-weight: 700;
                            color: Colors.foreground;
                            wrap: word-wrap;
                        }
                        Text {
                            width: card.about-width - 14px;
                            text: InstallerData.about-text;
                            font-size: 13px;
                            color: Colors.dim;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Space.m;
                ActionButton {
                    label: Tr.t("cancel");
                    clicked => { InstallerData.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    label: Tr.t("installer-back");
                    enabled: InstallerData.back-enabled;
                    clicked => { InstallerData.back(); }
                }
                ActionButton {
                    label: InstallerData.primary-label;
                    primary: true;
                    clicked => { InstallerData.next(); }
                }
            }
        }
    }
}
