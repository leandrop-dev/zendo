// The top bar: the name, the tabs (Library, Store, Stats), and the Downloads
// and Settings icon buttons, as in the Iced window's `app/top_bar.rs`; on the
// Library the view chips and the search.

import { Colors, Space, Tr } from "style.slint";
import { Tab, IconButton, ChipButton, SearchField } from "components.slint";
import { LibraryData } from "library.slint";
import { StoreData } from "store.slint";
import { GameModeData } from "game_mode.slint";

export enum Page { library, store, stats, downloads, settings, accounts, about }

// The row under the top bar on the three pages the Settings button holds:
// Settings, Accounts (with how many stores are signed in) and About.
export component SettingsTabs inherits Rectangle {
    in property <Page> page;
    in property <string> accounts-count;
    callback navigate(Page);
    background: Colors.sidebar;
    VerticalLayout {
        HorizontalLayout {
            padding-top: Space.s;
            padding-bottom: Space.s;
            padding-left: Space.xl;
            padding-right: Space.xl;
            spacing: Space.s;
            ChipButton {
                label: Tr.t("page-settings");
                chosen: root.page == Page.settings;
                clicked => { root.navigate(Page.settings); }
            }
            ChipButton {
                label: Tr.t("page-accounts");
                count: root.accounts-count;
                chosen: root.page == Page.accounts;
                clicked => { root.navigate(Page.accounts); }
            }
            ChipButton {
                label: Tr.t("page-about");
                chosen: root.page == Page.about;
                clicked => { root.navigate(Page.about); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle {
            height: 1px;
            background: Colors.line;
        }
    }
}

export component TopBar inherits Rectangle {
    in property <Page> page;
    in property <string> library-count;
    in property <string> store-count;
    in property <string> downloads-count;
    callback navigate(Page);
    // Ctrl+F and Ctrl+V: the search takes the keyboard.
    public function focus-search() {
        if root.page == Page.store { store-search.focus(); } else { search.focus(); }
    }
    public function paste-search() {
        if root.page == Page.store {
            store-search.focus();
            store-search.paste();
        } else {
            search.focus();
            search.paste();
        }
    }

    background: Colors.sidebar;

    VerticalLayout {
        HorizontalLayout {
            padding-top: Space.m;
            padding-bottom: Space.m;
            padding-left: Space.xl;
            padding-right: Space.xl;
            spacing: Space.s;

            HorizontalLayout {
                padding-right: Space.l - Space.s;
                spacing: 2px;
                Text {
                    text: "ZENDO";
                    font-size: 20px;
                    font-weight: 700;
                    color: Colors.foreground;
                    vertical-alignment: center;
                }
                Text {
                    text: "•";
                    font-size: 20px;
                    color: Colors.accent;
                    vertical-alignment: center;
                }
            }
            Tab {
                label: Tr.t("page-library");
                count: root.library-count;
                current: root.page == Page.library;
                clicked => { root.navigate(Page.library); }
            }
            Tab {
                label: Tr.t("page-store");
                count: root.store-count;
                current: root.page == Page.store;
                clicked => { root.navigate(Page.store); }
            }
            Tab {
                label: Tr.t("page-stats");
                current: root.page == Page.stats;
                clicked => { root.navigate(Page.stats); }
            }
            // While Game Mode is on and the grid is showing: back to its screen.
            if GameModeData.on: ChipButton {
                label: Tr.t("gm-screen");
                chosen: true;
                clicked => { GameModeData.show(); }
            }
            Rectangle { horizontal-stretch: 1; }
            // The view chips, on the Library only: beside the search.
            if root.page == Page.library: HorizontalLayout {
                spacing: Space.s;
                for chip in LibraryData.views: ChipButton {
                    label: chip.label;
                    count: chip.count;
                    chosen: chip.chosen;
                    clicked => { LibraryData.chip(chip.id); }
                }
            }
            // Always there, so Ctrl+F and Ctrl+V can reach them; no room on
            // the other pages. The Library and the Store each have a field
            // in the same place.
            Rectangle {
                width: root.page == Page.library || root.page == Page.store ? 220px : 0px;
                height: 34px;
                search := SearchField {
                    visible: root.page == Page.library;
                    width: parent.width;
                    placeholder: Tr.t("library-search");
                    text <=> LibraryData.search;
                    edited(text) => { LibraryData.search-edited(text); }
                    accepted => { LibraryData.key("\n", false, false, false, false); }
                }
                store-search := SearchField {
                    visible: root.page == Page.store;
                    width: parent.width;
                    placeholder: Tr.t("store-search");
                    text <=> StoreData.search;
                    edited(text) => { StoreData.search-edited(text); }
                    accepted => { LibraryData.key("\n", false, false, false, false); }
                }
            }
            IconButton {
                icon: @image-url("../icons/download.svg");
                label: Tr.t("page-downloads");
                count: root.downloads-count;
                current: root.page == Page.downloads;
                clicked => { root.navigate(Page.downloads); }
            }
            IconButton {
                icon: @image-url("../icons/settings.svg");
                label: Tr.t("page-settings");
                current: root.page == Page.settings || root.page == Page.accounts || root.page == Page.about;
                clicked => { root.navigate(Page.settings); }
            }
        }
        Rectangle {
            height: 1px;
            background: Colors.line;
        }
    }
}
