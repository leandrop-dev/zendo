// Nexus Mods in the window: the key and the link handler on the Settings page,
// the sheet that asks which game a link's mod is for, and the line of a mod
// downloading (drawn on the game's Mods card). Rust (src/nexus_ui.rs) fills
// `NexusData` and answers its callbacks; nothing here keeps state.

import { Colors, Space, Tr } from "style.slint";
import { ActionButton, RowButton } from "components.slint";
import { ScrollView } from "std-widgets.slint";

// A mod on its way in: its name, how far it got in words and as a fraction
// of the bar (nothing when its size is not known), and Stop.
export struct DownloadRow {
    id: int,
    name: string,
    words: string,
    fraction: float,
    stopping: bool,
}

export global NexusData {
    // The Settings page: the key's field and what it last said.
    in-out property <string> key-value;
    in property <bool> key-shown;
    in property <bool> key-checking;
    in property <bool> key-changed;
    in property <string> key-note;
    // 1 good, 2 bad, 3 dim.
    in property <int> key-tone;
    in property <string> key-kept;
    in property <bool> key-kept-bad;
    // What opens `nxm://` links, and whether Open them with Zendo is pressable.
    in property <string> handler-line;
    in property <bool> handler-good;
    in property <bool> handler-can;

    callback key-edited(string);
    callback key-toggle-shown();
    callback key-check();
    callback key-save();
    callback key-get();
    callback become-handler();

    // The chooser: which game a link's mod goes to.
    in property <bool> choosing;
    in property <string> choose-about;
    in property <[string]> choices;
    callback choose(int);
    callback cancel-choose();
}

// One download's line, with a bar under it and Stop.
export component DownloadLine inherits VerticalLayout {
    in property <DownloadRow> item;
    callback stop(int);
    spacing: Space.s;
    HorizontalLayout {
        spacing: Space.m;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.item.name;
                font-size: 14px;
                color: Colors.foreground;
                overflow: elide;
            }
            Text {
                text: root.item.words;
                font-size: 12px;
                color: Colors.dim;
                overflow: elide;
            }
        }
        RowButton {
            label: root.item.stopping ? Tr.t("nexus-stopping") : Tr.t("nexus-stop");
            enabled: !root.item.stopping;
            clicked => { root.stop(root.item.id); }
        }
    }
    Rectangle {
        height: 6px;
        background: Colors.raised;
        Rectangle {
            x: 0px;
            width: parent.width * Math.max(0, Math.min(root.item.fraction, 1));
            background: Colors.accent;
        }
    }
}

// The question over the window, first to hear Escape.
export component ChooserSheet inherits Rectangle {
    background: #000000.with-alpha(0.6);
    // Nothing behind the sheet hears a click; one outside the card closes it.
    TouchArea {
        clicked => { NexusData.cancel-choose(); }
    }
    card := Rectangle {
        width: min(560px, root.width - 2 * Space.xl);
        height: min(root.height - 2 * Space.xl, body.preferred-height);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Colors.background;
        border-width: 1px;
        border-color: Colors.line;
        // Clicks inside the card stay in it.
        TouchArea { }
        body := VerticalLayout {
            padding: Space.xl;
            spacing: Space.l;
            Text {
                text: Tr.t("nexus-choose-title").to-uppercase();
                font-size: 18px;
                font-weight: 700;
                color: Colors.foreground;
            }
            Text {
                text: NexusData.choose-about;
                font-size: 13px;
                color: Colors.dim;
                wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                min-height: min(list.preferred-height, 260px);
                preferred-height: list.preferred-height;
                list := VerticalLayout {
                    x: 0px;
                    // Room at the right for the scrollbar.
                    width: parent.width - 14px;
                    alignment: start;
                    spacing: Space.xs;
                    for title[index] in NexusData.choices: ActionButton {
                        label: title;
                        clicked => { NexusData.choose(index); }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                ActionButton {
                    label: Tr.t("cancel");
                    clicked => { NexusData.cancel-choose(); }
                }
            }
        }
    }
}
