// Game Mode: the full-screen, controller-first screen of one game large (the
// hero) over a row of covers (the carousel). Rust (src/game_mode_ui.rs) fills
// `GameModeData` and decides which tiles are shown; nothing here picks a game.

import { Colors, Space, Tr } from "style.slint";
import { ChipButton, ActionButton } from "components.slint";
import { ChipData } from "library.slint";

// A cover in the carousel: the one in the hero has `current`.
export struct GmTile {
    title: string,
    has-cover: bool,
    loading: bool,
    cover: image,
    current: bool,
}

export global GameModeData {
    // Game Mode is on (the window is full screen).
    in property <bool> on;
    // The library's own grid is showing, not the screen: the top bar then
    // has a chip back to it.
    in property <bool> browsing;
    // Nothing to show: no game at all.
    in property <bool> empty;
    in property <[ChipData]> shelves;
    in property <[GmTile]> tiles;
    in property <string> meta;
    in property <string> title;
    in property <string> description;
    in property <bool> hero-has-cover;
    in property <bool> hero-loading;
    in property <image> hero-cover;
    // The Start menu: its choices, one of them chosen.
    in property <bool> menu-open;
    in property <[ChipData]> menu;
    // The window's width, written by the screen, for how many tiles fit.
    in-out property <length> width;
    callback resized();
    callback shelf(int);
    callback pick(int);
    callback open-menu();
    callback close-menu();
    callback choose(int);
    callback play();
    callback details();
    // The top bar's chip: back to the screen from the grid.
    callback show();
    // The language changed: the texts Rust builds are asked for again.
    callback relabel();
}

component Placeholder inherits Rectangle {
    in property <string> label;
    in property <bool> loading;
    in property <length> size: 12px;
    background: Colors.surface;
    if !root.loading: Text {
        width: parent.width - 2 * Space.s;
        x: Space.s;
        text: root.label;
        font-size: root.size;
        color: Colors.foreground;
        wrap: word-wrap;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component GameModeScreen inherits Rectangle {
    init => { GameModeData.width = root.width; GameModeData.resized(); }
    changed width => { GameModeData.width = root.width; GameModeData.resized(); }

    VerticalLayout {
        // The header: the name, the shelves and the menu.
        Rectangle {
            vertical-stretch: 0;
            background: Colors.sidebar;
            HorizontalLayout {
                padding: Space.m;
                padding-left: Space.xl;
                padding-right: Space.xl;
                spacing: Space.s;
                Text {
                    text: "ZENDO";
                    font-size: 20px;
                    font-weight: 700;
                    color: Colors.foreground;
                    vertical-alignment: center;
                }
                Text {
                    text: "•";
                    font-size: 20px;
                    color: Colors.accent;
                    vertical-alignment: center;
                }
                Rectangle { width: Space.xl; }
                for chip in GameModeData.shelves: ChipButton {
                    label: chip.label;
                    count: chip.count;
                    chosen: chip.chosen;
                    clicked => { GameModeData.shelf(chip.id); }
                }
                Rectangle { horizontal-stretch: 1; }
                ActionButton {
                    label: Tr.t("gm-menu");
                    clicked => { GameModeData.open-menu(); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Colors.line;
        }

        if GameModeData.empty: Rectangle {
            vertical-stretch: 1;
            Text {
                text: Tr.t("gm-empty");
                color: Colors.dim;
            }
        }
        if !GameModeData.empty: VerticalLayout {
            vertical-stretch: 1;
            padding: Space.xl;
            spacing: Space.xl;
            // The hero: the cover, and the game's line, name, summary, actions.
            HorizontalLayout {
                spacing: Space.xl;
                vertical-stretch: 0;
                Rectangle {
                    width: 260px;
                    height: 390px;
                    clip: true;
                    background: Colors.surface;
                    if GameModeData.hero-has-cover: Image {
                        width: 100%;
                        height: 100%;
                        source: GameModeData.hero-cover;
                        image-fit: cover;
                    }
                    if !GameModeData.hero-has-cover: Placeholder {
                        label: GameModeData.title;
                        loading: GameModeData.hero-loading;
                        size: 22px;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: Space.m;
                    alignment: start;
                    Text {
                        text: GameModeData.meta;
                        font-size: 13px;
                        color: Colors.dim;
                        overflow: elide;
                    }
                    Text {
                        text: GameModeData.title;
                        font-size: 40px;
                        font-weight: 700;
                        color: Colors.foreground;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 120px;
                        clip: true;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.line;
                        Text {
                            x: Space.m;
                            y: Space.m;
                            width: parent.width - 2 * Space.m;
                            text: GameModeData.description;
                            font-size: 15px;
                            color: Colors.foreground;
                            wrap: word-wrap;
                        }
                    }
                    HorizontalLayout {
                        spacing: Space.s;
                        alignment: start;
                        ActionButton {
                            label: Tr.t("run-play");
                            primary: true;
                            clicked => { GameModeData.play(); }
                        }
                        ActionButton {
                            label: Tr.t("game-mode-details");
                            clicked => { GameModeData.details(); }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
            // The carousel: the covers around the one in the hero.
            HorizontalLayout {
                vertical-stretch: 0;
                alignment: center;
                spacing: Space.s;
                for tile[at] in GameModeData.tiles: Rectangle {
                    width: 118px;
                    height: 173px;
                    border-width: tile.current ? 2px : 1px;
                    border-color: tile.current ? Colors.accent : Colors.line;
                    Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        clip: true;
                        if tile.has-cover: Image {
                            width: 100%;
                            height: 100%;
                            source: tile.cover;
                            image-fit: cover;
                        }
                        if !tile.has-cover: Placeholder {
                            label: tile.title;
                            loading: tile.loading;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: tile.title;
                        accessible-action-default => { GameModeData.pick(at); }
                        clicked => { GameModeData.pick(at); }
                    }
                }
            }
        }
        Text {
            text: Tr.t("hints-game-mode");
            font-size: 13px;
            color: Colors.dim;
            horizontal-alignment: center;
        }
        Rectangle { height: Space.s; }
    }

    // The Start menu, over the screen.
    if GameModeData.menu-open: Rectangle {
        background: Colors.scrim;
        TouchArea {
            clicked => { GameModeData.close-menu(); }
        }
        Rectangle {
            width: 420px;
            height: menu-column.preferred-height + 2 * Space.l;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.line;
            TouchArea { }
            menu-column := VerticalLayout {
                padding: Space.l;
                spacing: Space.s;
                Text {
                    text: Tr.t("gm-menu").to-uppercase();
                    font-size: 14px;
                    font-weight: 700;
                    color: Colors.foreground;
                }
                for choice in GameModeData.menu: Rectangle {
                    height: 36px;
                    border-width: 1px;
                    border-color: choice.chosen ? Colors.accent : Colors.line;
                    background: choice-touch.has-hover ? Colors.raised : transparent;
                    Text {
                        text: choice.label.to-uppercase();
                        font-size: 13px;
                        color: choice.chosen ? Colors.accent : Colors.foreground;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    choice-touch := TouchArea {
                        mouse-cursor: pointer;
                        accessible-role: radio-button;
                        accessible-label: choice.label;
                        accessible-checked: choice.chosen;
                        accessible-action-default => { GameModeData.choose(choice.id); }
                        clicked => { GameModeData.choose(choice.id); }
                    }
                }
                Text {
                    text: Tr.t("gm-menu-hint");
                    font-size: 13px;
                    color: Colors.dim;
                    wrap: word-wrap;
                }
            }
        }
    }
}
