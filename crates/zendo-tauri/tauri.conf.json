{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "zendo",
	"identifier": "dev.leandrop.zendo",
	"build": {
		"frontendDist": "ui/build",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Zendo",
				"width": 1360,
				"height": 860,
				"minWidth": 1100,
				"minHeight": 560,
				"resizable": true
			}
		]
	},
	"bundle": {
		"active": false,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png"
		]
	}
}
